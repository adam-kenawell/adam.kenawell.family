---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;

const cards = [
  { title: 'Blog', href: `${base}blog` },
  { title: 'R\u00e9sum\u00e9', href: `${base}resume` },
  { title: 'Projects', href: `${base}projects` },
];
---

<Layout title="Adam Kenawell">
  <div class="page">
    <Header showNav={false} />

    <main>
      <p class="tagline">Data Engineer &middot; Builder &middot; Lifelong Learner</p>
      <div class="cards">
        {cards.map((card) => (
          <a class="card" href={card.href}>
            <span>{card.title}</span>
          </a>
        ))}
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
  }

  .tagline {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.03em;
  }

  .cards {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .card {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 200px;
    height: 200px;
    border: 2px solid rgba(245, 208, 0, 0.5);
    background-color: rgba(26, 26, 26, 0.9);
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.25rem;
    letter-spacing: 0.05em;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition: background-color 0.2s, color 0.2s, transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .card:hover {
    background-color: #f5d000;
    color: #1a1a1a;
    border-color: #f5d000;
    transform: translateY(-4px) scale(1.05);
    box-shadow: 0 8px 32px rgba(245, 208, 0, 0.35), 0 4px 12px rgba(0, 0, 0, 0.3), 0 0 20px rgba(245, 208, 0, 0.15);
  }

  @media (max-width: 600px) {
    main {
      gap: 1.25rem;
      padding: 1.5rem 1rem;
    }

    .card {
      width: 100%;
      max-width: 280px;
      height: 80px;
      font-size: 1.1rem;
    }
  }
</style>
