---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const projects = [
  { title: 'adam.kenawell.family', description: 'This personal website — built with Astro and hosted on GitHub Pages.', tech: ['Astro', 'CSS', 'GitHub Pages'], url: 'https://github.com/adam-kenawell/adam.kenawell.family' },
  { title: 'Project Alpha', description: 'A placeholder project showcasing full-stack development skills.', tech: ['TypeScript', 'Node.js', 'React'], url: '#' },
  { title: 'Project Beta', description: 'Another placeholder — maybe a CLI tool, maybe a game, who knows.', tech: ['Python', 'Linux'], url: '#' },
];
---

<Layout title="Projects — Adam Kenawell">
  <div class="page">
    <Header />

    <main>
      {projects.map((project) => (
        <a class="project-card" href={project.url} target="_blank" rel="noopener">
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <div class="tech-tags">
            {project.tech.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        </a>
      ))}
    </main>

    <footer>
      <span>&copy; 2026 Adam Kenawell</span>
    </footer>
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 2.5rem 2rem;
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
    align-content: start;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 2px solid rgba(245, 208, 0, 0.5);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    text-decoration: none;
    color: #f5d000;
    transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(245, 208, 0, 0.2), 0 4px 12px rgba(0, 0, 0, 0.3);
    background-color: rgba(255, 255, 255, 0.1);
  }

  .project-card h2 {
    font-size: 1.1rem;
  }

  .project-card p {
    font-size: 0.85rem;
    opacity: 0.7;
    line-height: 1.5;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .tag {
    padding: 0.25rem 0.6rem;
    border: 1px solid rgba(245, 208, 0, 0.4);
    border-radius: 5px;
    font-size: 0.7rem;
    opacity: 0.6;
  }

  footer {
    text-align: center;
    padding: 1.5rem;
    font-size: 0.75rem;
    opacity: 0.6;
  }
</style>
