---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Add projects here as objects with title, description, tech[], and url.
const projects: { title: string; description: string; tech: string[]; url: string }[] = [
  // Example:
  // { title: 'My Project', description: 'A cool thing I built.', tech: ['Astro', 'TypeScript'], url: 'https://github.com/...' },
];
---

<Layout title="Projects — Adam Kenawell">
  <div class="page">
    <Header />

    <main>
      {projects.length > 0 ? (
        projects.map((project) => (
          <a class="project-card" href={project.url} target="_blank" rel="noopener">
            <h2>{project.title}</h2>
            <p>{project.description}</p>
            <div class="tech-tags">
              {project.tech.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </a>
        ))
      ) : (
        <div class="empty-state">
          <p>nothing to see here!</p>
          <p class="sub">looks like someone's been slacking on their projects!</p>
        </div>
      )}
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 2.5rem 2rem;
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
    align-content: start;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 2px solid rgba(245, 208, 0, 0.5);
    border-radius: 8px;
    background-color: rgba(26, 26, 26, 0.9);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    text-decoration: none;
    color: #f5d000;
    transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(245, 208, 0, 0.2), 0 4px 12px rgba(0, 0, 0, 0.3);
    background-color: rgba(255, 255, 255, 0.1);
  }

  .project-card h2 {
    font-size: 1.1rem;
  }

  .project-card p {
    font-size: 0.85rem;
    opacity: 0.7;
    line-height: 1.5;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .tag {
    padding: 0.25rem 0.6rem;
    border: 1px solid rgba(245, 208, 0, 0.4);
    border-radius: 5px;
    font-size: 0.7rem;
    opacity: 0.6;
  }

  @media (max-width: 600px) {
    main {
      padding: 1.5rem 1rem;
      grid-template-columns: 1fr;
    }

    .project-card {
      padding: 1.1rem;
    }
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 2rem;
    opacity: 0.7;
  }

  .empty-state p {
    font-size: 1.2rem;
  }

  .empty-state .sub {
    font-size: 0.85rem;
    margin-top: 0.5rem;
    opacity: 0.6;
  }
</style>
