---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;

// Add projects here as objects with title, description, tech[], and url.
const projects: { title: string; description: string; tech: string[]; url: string }[] = [
  {
    title: 'Local LLM Stack via Openclaw',
    description: 'My personal setup for running large language models locally on consumer hardware. Built this site with it.',
    tech: ['Openclaw', 'RTX 4070', 'Galaxy Book 4 Ultra', 'LLM', 'Agentic AI'],
    url: `${base}projects/local-llm-stack`,
  },
  {
    title: 'PokePaste Visualizer',
    description: 'Paste a PokePaste team export and get a clean visual breakdown with sprites, stats, and moves.',
    tech: ['Pokemon', 'PokeAPI', 'Astro', 'Client-side JS'],
    url: `${base}projects/pokepaste-visualizer`,
  },
];
---

<Layout title="Projects — Adam Kenawell" description="Side projects and experiments from Adam Kenawell.">
  <div class="page">
    <Header />

    <main>
      {projects.length > 0 ? (
        projects.map((project) => (
          <a class="project-card" href={project.url}>
            <h2>{project.title}</h2>
            <p>{project.description}</p>
            <div class="tech-tags">
              {project.tech.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </a>
        ))
      ) : (
        <div class="empty-state">
          <p>nothing to see here!</p>
          <p class="sub">looks like someone's been slacking on their projects!</p>
        </div>
      )}
    </main>

    <Footer />
  </div>
</Layout>

<style>
  main {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 2.5rem 2rem;
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
    align-content: start;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 2px solid rgba(var(--accent-rgb), 0.5);
    border-radius: 8px;
    background-color: var(--bg-card);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    text-decoration: none;
    color: var(--accent);
    transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(var(--accent-rgb), 0.2), 0 4px 12px rgba(0, 0, 0, 0.3);
    background-color: rgba(255, 255, 255, 0.1);
  }

  .project-card h2 {
    font-size: 1.1rem;
  }

  .project-card p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .tag {
    padding: 0.25rem 0.6rem;
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 5px;
    font-size: 0.7rem;
    opacity: 0.6;
  }

  @media (max-width: 600px) {
    main {
      padding: 1.5rem 1rem;
      grid-template-columns: 1fr;
    }

    .project-card {
      padding: 1.1rem;
    }
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 2rem;
    opacity: 0.7;
  }

  .empty-state p {
    font-size: 1.2rem;
  }

  .empty-state .sub {
    font-size: 0.85rem;
    margin-top: 0.5rem;
    opacity: 0.6;
  }
</style>
