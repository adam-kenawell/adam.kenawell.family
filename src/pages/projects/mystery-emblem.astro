  }

  .pmd-squad-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
    gap: 0.85rem;
  }

  :global(.pmd-unit-card) {
    background: rgba(10, 18, 34, 0.88);
    border: 2px solid rgba(72, 184, 232, 0.65);
    border-radius: 6px;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  :global(.pmd-unit-top) {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  :global(.pmd-unit-sprite) {
    min-width: 56px;
