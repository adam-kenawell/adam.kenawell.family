    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.25rem 1rem;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .pmd-viewport {
    position: relative;
    width: 100%;
    min-height: 540px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 4.35rem 1.25rem 2rem;
    border-radius: 8px;
    background: radial-gradient(circle at center, rgba(24, 40, 72, 0.78) 0%, rgba(10, 14, 24, 0.94) 100%);
    border: 2px solid rgba(88, 200, 248, 0.35);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.65);
