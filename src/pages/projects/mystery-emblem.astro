  }

  .pmd-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .pmd-tab-btn {
    flex: 1 1 150px;
  }

  .pmd-tab-panel {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .pmd-empty-box {
    padding: 1.5rem;
    text-align: center;
    border: 1px dashed rgba(72, 184, 232, 0.45);
    border-radius: 6px;
