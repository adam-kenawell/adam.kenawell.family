---
const targetUrl = 'https://mysteryemblem.com/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting to Mystery Emblem…</title>
    <link rel="canonical" href={targetUrl} />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <script is:inline>
      window.location.replace('https://mysteryemblem.com/');
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #081226;
        color: #eef6ff;
        font-family: system-ui, -apple-system, sans-serif;
        text-align: center;
        padding: 1.5rem;
      }
      a {
        color: #68d8ff;
      }
    </style>
  </head>
  <body>
    <p>
      Mystery Emblem has moved to <a href={targetUrl}>mysteryemblem.com</a>.
    </p>
  </body>
</html>
