---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="PokePaste Visualizer — Adam Kenawell">
  <div class="page">
    <Header />
    <main>
      <div id="input-view">
        <input id="team-name-input" type="text" placeholder="Team 1" />
        <textarea id="paste-input" placeholder="Paste PokePaste here"></textarea>
        <div class="btn-row">
          <button id="visualize-btn">Visualize</button>
        </div>
      </div>

      <div id="output-view" style="display:none;">
        <div class="output-actions">
          <button id="back-btn">← Back</button>
          <button id="save-btn">Save Team</button>
          <button id="toggle-tags-btn">Show Tags</button>
          <button id="toggle-sprites-btn">Static Sprites</button>
        </div>
        <div id="team-card"></div>
      </div>

      <div id="saved-section">
        <h2>Saved Teams</h2>
        <button id="delete-all-btn" style="display:none;">Delete All Teams</button>
        <div id="saved-list"></div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>

<script>
  import {
    createSpriteWidget, resetWidgets,
    parsePokepaste, type ParsedMon,
    TYPE_COLORS, colorizeEvs, getTypeGradient,
    fetchPokemonData, fetchMoveType,
    loadSavedTeams, saveSavedTeams, getNextTeamNumber,
    ROLE_OPTIONS,
    DEFAULT_PASTE,
  } from 'pmd-visualizer';

  let useAnimatedSprites = true;
  let tagsVisible = false;

  // ── Rendering ──────────────────────────────────────────
  async function renderTeamCard(team: ParsedMon[], teamName: string, savedRoles?: string[][]) {
    const card = document.getElementById('team-card')!;
    card.innerHTML = `<h2 class="team-title">${teamName}</h2><div class="team-members"></div>`;
    const membersEl = card.querySelector('.team-members')!;

    for (const mon of team) {
      const cell = document.createElement('div');
      cell.className = 'mon-cell';

      const bodyRow = document.createElement('div');
      bodyRow.className = 'mon-body';

      const spriteCell = document.createElement('div');
      spriteCell.className = 'mon-sprite';
      spriteCell.innerHTML = '<span class="loading-sprite">...</span>';
      bodyRow.appendChild(spriteCell);

      const infoWrapper = document.createElement('div');
      infoWrapper.className = 'mon-info-wrapper';

      const nameEl = document.createElement('h3');
      nameEl.className = 'mon-name';
      nameEl.textContent = mon.species;
      infoWrapper.appendChild(nameEl);

      const infoCell = document.createElement('div');
      infoCell.className = 'mon-info';
      infoCell.innerHTML = `
        <p class="item-text">@ ${mon.item}</p>
        <p class="stat-line"><strong>Ability:</strong> ${mon.ability}</p>
        <p class="stat-line"><strong>Nature:</strong> ${mon.nature}</p>
        <p class="stat-line evs-line"><strong>EVs:</strong> ${colorizeEvs(mon.evs)}</p>
      `;
      infoWrapper.appendChild(infoCell);
      bodyRow.appendChild(infoWrapper);
      cell.appendChild(bodyRow);

      const movesEl = document.createElement('div');
      movesEl.className = 'moves';
      movesEl.innerHTML = mon.moves.map(m => `<span class="move-pill" data-move="${m}">${m}</span>`).join('');
      cell.appendChild(movesEl);

      const tagsEl = document.createElement('div');
      tagsEl.className = 'role-tags';
      const monIndex = team.indexOf(mon);
      const savedMonRoles = savedRoles?.[monIndex] || [];

      function addTagSelect(tagsContainer: HTMLElement, initialVal: string) {
        const sel = document.createElement('select');
        sel.className = 'role-select';
        sel.innerHTML = ROLE_OPTIONS.map(r =>
          `<option value="${r}"${r === initialVal ? ' selected' : ''}>${r === 'None' ? '—' : r}</option>`
        ).join('');
        if (initialVal !== 'None') sel.classList.add('active');
        sel.addEventListener('change', () => {
          sel.classList.toggle('active', sel.value !== 'None');
        });
        // Insert before the + button
        const addBtn = tagsContainer.querySelector('.add-tag-btn');
        if (addBtn) tagsContainer.insertBefore(sel, addBtn);
        else tagsContainer.appendChild(sel);
        updateAddBtn(tagsContainer);
      }

      function updateAddBtn(tagsContainer: HTMLElement) {
        let btn = tagsContainer.querySelector('.add-tag-btn') as HTMLElement;
        const count = tagsContainer.querySelectorAll('.role-select').length;
        if (count >= 3) {
          if (btn) btn.style.display = 'none';
        } else {
          if (!btn) {
            btn = document.createElement('button');
            btn.className = 'add-tag-btn';
            btn.textContent = '+';
            btn.addEventListener('click', () => {
              addTagSelect(tagsContainer, 'None');
            });
            tagsContainer.appendChild(btn);
          }
          btn.style.display = '';
        }
      }

      // Restore saved roles
      const activeCount = savedMonRoles.filter(r => r && r !== 'None').length;
      for (let t = 0; t < activeCount && t < 3; t++) {
        addTagSelect(tagsEl, savedMonRoles[t] || 'None');
      }
      updateAddBtn(tagsEl);
      cell.appendChild(tagsEl);

      membersEl.appendChild(cell);

      // Load pokemon data for sprite + type coloring
      fetchPokemonData(mon.species).then(async (data) => {
        if (data) {
          // Color the name by type
          const types: string[] = data.types.map((t: any) => t.type.name);
          const nameTag = cell.querySelector('.mon-name') as HTMLElement;
          if (types.length === 1) {
            nameTag.style.color = TYPE_COLORS[types[0]] || '#fff';
          } else {
            nameTag.style.background = getTypeGradient(types);
            nameTag.style.webkitBackgroundClip = 'text';
            nameTag.style.webkitTextFillColor = 'transparent';
            nameTag.style.backgroundClip = 'text';
          }

          // Build static sprite
          const staticUrl = data.sprites?.other?.['official-artwork']?.front_default
            || data.sprites?.front_default || '';
          const staticHtml = staticUrl
            ? `<img src="${staticUrl}" class="fallback-sprite" alt="${mon.species}" />`
            : '<span class="no-sprite">?</span>';

          // Build animated sprite
          const canvas = await createSpriteWidget(data.id);

          // Store both on the element for toggling
          spriteCell.dataset.staticHtml = staticHtml;
          spriteCell.dataset.hasAnimated = canvas ? 'true' : 'false';

          spriteCell.innerHTML = '';
          if (canvas) {
            spriteCell.appendChild(canvas);
          } else {
            spriteCell.innerHTML = staticHtml;
          }

          // If currently in static mode, swap now
          if (!useAnimatedSprites) {
            spriteCell.innerHTML = staticHtml;
          }
        } else {
          spriteCell.innerHTML = '<span class="no-sprite">?</span>';
        }
      });

      // Color moves by type
      const movePills = cell.querySelectorAll('.move-pill');
      movePills.forEach(async (pill) => {
        const moveName = (pill as HTMLElement).dataset.move!;
        const moveType = await fetchMoveType(moveName);
        const color = TYPE_COLORS[moveType] || 'rgba(255,255,255,0.85)';
        (pill as HTMLElement).style.borderColor = color;
        (pill as HTMLElement).style.color = color;
        (pill as HTMLElement).style.background = color + '18';
      });
    }
  }

  function renderSavedTeams() {
    const list = document.getElementById('saved-list')!;
    const deleteAllBtn = document.getElementById('delete-all-btn')!;
    const teams = loadSavedTeams();

    if (teams.length === 0) {
      list.innerHTML = '<p class="empty">No saved teams yet.</p>';
      deleteAllBtn.style.display = 'none';
      return;
    }

    deleteAllBtn.style.display = 'inline-block';
    list.innerHTML = '';
    teams.forEach(team => {
      const item = document.createElement('div');
      item.className = 'saved-item';
      item.innerHTML = `
        <span class="saved-name">${team.name}</span>
        <div class="saved-actions">
          <button class="load-btn" data-id="${team.id}">Load</button>
          <button class="del-btn" data-id="${team.id}">Delete</button>
        </div>
      `;
      list.appendChild(item);
    });

    list.querySelectorAll('.load-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id!;
        const team = loadSavedTeams().find(t => t.id === id);
        if (!team) return;
        resetWidgets();
        const parsed = parsePokepaste(team.paste);
        document.getElementById('input-view')!.style.display = 'none';
        document.getElementById('output-view')!.style.display = 'block';
        renderTeamCard(parsed, team.name, team.roles);
        // Restore tag visibility
        if (team.tagsVisible) {
          tagsVisible = true;
          document.getElementById('toggle-tags-btn')!.textContent = 'Hide Tags';
          document.querySelectorAll('.role-tags').forEach(el => {
            (el as HTMLElement).style.display = 'flex';
          });
        }
      });
    });

    list.querySelectorAll('.del-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id!;
        const teams = loadSavedTeams().filter(t => t.id !== id);
        saveSavedTeams(teams);
        renderSavedTeams();
      });
    });
  }

  // ── Event Wiring ───────────────────────────────────────
  // Wrap in astro:page-load so listeners re-attach after view transitions
  function initVisualizer() {
    resetWidgets();

    const nameInput = document.getElementById('team-name-input') as HTMLInputElement;
    if (!nameInput) return; // not on this page
    nameInput.placeholder = `Team ${getNextTeamNumber()}`;

    // Set default paste text if empty
    const pasteInput = document.getElementById('paste-input') as HTMLTextAreaElement;
    if (pasteInput && !pasteInput.value.trim()) {
      pasteInput.value = DEFAULT_PASTE;
    }

    // Show background sprites on this page
    const spriteContainer = document.getElementById('sprite-background');
    if (spriteContainer) spriteContainer.style.display = '';
    const spriteToggleBtn = document.getElementById('sprite-toggle-btn');
    if (spriteToggleBtn) spriteToggleBtn.textContent = 'Hide';

    document.getElementById('visualize-btn')!.addEventListener('click', () => {
      const text = (document.getElementById('paste-input') as HTMLTextAreaElement).value;
      if (!text.trim()) return;
      resetWidgets();
      const team = parsePokepaste(text);
      const name = nameInput.value.trim() || nameInput.placeholder;
      document.getElementById('input-view')!.style.display = 'none';
      document.getElementById('output-view')!.style.display = 'block';
      renderTeamCard(team, name);
    });

    document.getElementById('back-btn')!.addEventListener('click', () => {
      resetWidgets();
      document.getElementById('input-view')!.style.display = 'flex';
      document.getElementById('output-view')!.style.display = 'none';
    });

    const toggleTagsBtn = document.getElementById('toggle-tags-btn')!;
    tagsVisible = false;
    toggleTagsBtn.textContent = 'Show Tags';
    toggleTagsBtn.addEventListener('click', () => {
      tagsVisible = !tagsVisible;
      toggleTagsBtn.textContent = tagsVisible ? 'Hide Tags' : 'Show Tags';
      document.querySelectorAll('.role-tags').forEach(el => {
        (el as HTMLElement).style.display = tagsVisible ? 'flex' : 'none';
      });
    });

    useAnimatedSprites = true;
    const toggleSpritesBtn = document.getElementById('toggle-sprites-btn')!;
    toggleSpritesBtn.addEventListener('click', () => {
      useAnimatedSprites = !useAnimatedSprites;
      toggleSpritesBtn.textContent = useAnimatedSprites ? 'Static Sprites' : 'Animated Sprites';
      document.querySelectorAll('.mon-sprite').forEach(spriteCell => {
        const el = spriteCell as HTMLElement;
        if (useAnimatedSprites) {
          if (el.dataset.hasAnimated === 'true') {
            el.querySelectorAll('canvas').forEach(c => (c as HTMLElement).style.display = '');
            el.querySelectorAll('img').forEach(c => (c as HTMLElement).style.display = 'none');
            el.querySelectorAll('.no-sprite').forEach(c => (c as HTMLElement).style.display = 'none');
          }
        } else {
          const staticHtml = el.dataset.staticHtml;
          if (staticHtml) {
            el.querySelectorAll('canvas').forEach(c => (c as HTMLElement).style.display = 'none');
            if (!el.querySelector('.fallback-sprite')) {
              const wrapper = document.createElement('span');
              wrapper.innerHTML = staticHtml;
              const img = wrapper.firstElementChild;
              if (img) el.appendChild(img);
            } else {
              el.querySelectorAll('.fallback-sprite').forEach(c => (c as HTMLElement).style.display = '');
            }
          }
        }
      });
    });

    document.getElementById('save-btn')!.addEventListener('click', () => {
      const text = (document.getElementById('paste-input') as HTMLTextAreaElement).value;
      if (!text.trim()) return;
      const name = nameInput.value.trim() || nameInput.placeholder;
      const cells = document.querySelectorAll('#team-card .mon-cell');
      const roles: string[][] = [];
      cells.forEach(cell => {
        const selects = cell.querySelectorAll('.role-select') as NodeListOf<HTMLSelectElement>;
        roles.push(Array.from(selects).map(s => s.value));
      });
      const teams = loadSavedTeams();
      teams.push({ id: Date.now().toString(), name, paste: text, roles, tagsVisible });
      saveSavedTeams(teams);
      renderSavedTeams();
      nameInput.placeholder = `Team ${getNextTeamNumber()}`;
    });

    document.getElementById('delete-all-btn')!.addEventListener('click', () => {
      if (!confirm('Delete all saved teams?')) return;
      saveSavedTeams([]);
      renderSavedTeams();
      nameInput.placeholder = 'Team 1';
    });

    renderSavedTeams();
  }

  // Run on initial load and on every view transition navigation
  document.addEventListener('astro:page-load', initVisualizer);
</script>

<style>
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 2rem;
  }

  #input-view {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  #team-name-input {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 8px;
    color: var(--accent);
    font-size: 1.2rem;
    padding: 0.7rem 1rem;
    outline: none;
    transition: border-color 0.2s;
  }

  #team-name-input:focus {
    border-color: var(--accent);
  }

  #team-name-input::placeholder {
    color: rgba(var(--accent-rgb), 0.4);
  }

  #paste-input {
    flex: 1;
    width: 100%;
    min-height: 55vh;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 12px;
    color: var(--text);
    font-family: 'Courier New', monospace;
    font-size: 0.95rem;
    padding: 1.5rem;
    resize: none;
    outline: none;
    transition: border-color 0.2s;
  }

  #paste-input:focus {
    border-color: var(--accent);
  }

  #paste-input::placeholder {
    color: var(--text-faint);
    font-size: 1.4rem;
  }

  .btn-row {
    display: flex;
    justify-content: center;
  }

  #visualize-btn {
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: 8px;
    padding: 0.8rem 3rem;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  #visualize-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(var(--accent-rgb), 0.4);
  }

  .output-actions {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  #back-btn, #save-btn, #toggle-tags-btn, #toggle-sprites-btn {
    background: none;
    border: 1px solid rgba(var(--accent-rgb), 0.5);
    color: var(--accent);
    border-radius: 6px;
    padding: 0.5rem 1.2rem;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background 0.2s, color 0.2s;
  }

  #back-btn:hover, #save-btn:hover, #toggle-tags-btn:hover, #toggle-sprites-btn:hover {
    background: var(--accent);
    color: var(--bg);
  }

  #team-card {
    background: var(--bg);
    border: 1px solid rgba(var(--accent-rgb), 0.5);
    border-radius: 12px;
    padding: 1.5rem;
    position: relative;
    z-index: 1;
  }

  #team-card :global(.team-title) {
    color: var(--accent);
    margin: 0 0 1rem;
    font-size: 1.2rem;
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.2);
    padding-bottom: 0.5rem;
  }

  #team-card :global(.team-members) {
    display: grid;
    grid-template-columns: repeat(3, minmax(160px, 250px));
    gap: 0.8rem;
    justify-content: center;
  }

  #team-card :global(.mon-cell) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.6rem;
    padding-bottom: 1.8rem;
    border: 1px solid rgba(var(--accent-rgb), 0.06);
    border-radius: 8px;
    background: rgba(var(--accent-rgb), 0.03);
    aspect-ratio: 1;
    overflow: hidden;
    position: relative;
    min-width: 0;
  }

  #team-card :global(.mon-body) {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  #team-card :global(.mon-info-wrapper) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  #team-card :global(.mon-name) {
    text-align: center;
    font-size: 0.85rem;
    margin: 0 0 0.3rem;
    color: var(--text);
  }

  #team-card :global(.mon-sprite) {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #team-card :global(.poke-sprite-canvas) {
    image-rendering: pixelated;
    cursor: pointer;
    max-width: 64px;
    max-height: 64px;
  }

  #team-card :global(.fallback-sprite) {
    max-width: 64px;
    max-height: 64px;
    object-fit: contain;
  }

  #team-card :global(.no-sprite) {
    font-size: 2rem;
    color: var(--text-faint);
  }

  #team-card :global(.loading-sprite) {
    color: var(--text-faint);
  }

  #team-card :global(.mon-info) {
    flex: 1;
    text-align: center;
  }

  #team-card :global(.mon-info h3) {
    color: var(--text);
    margin: 0 0 0.1rem;
    font-size: 0.9rem;
  }

  #team-card :global(.item-text) {
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.7rem;
    margin: 0 0 0.3rem;
  }

  #team-card :global(.stat-line) {
    margin: 0.1rem 0;
    font-size: 0.7rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #team-card :global(.evs-line) {
    font-size: min(0.55rem, 1.8vw);
  }

  #team-card :global(.moves) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    margin-top: 0.8rem;
  }

  #team-card :global(.move-pill) {
    background: rgba(var(--accent-rgb), 0.12);
    border: 1px solid rgba(var(--accent-rgb), 0.3);
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
    font-size: 0.65rem;
    color: var(--text);
    text-align: center;
  }

  #team-card :global(.role-tags) {
    display: none;
    gap: 0.25rem;
    margin-top: 0.6rem;
    align-items: center;
    position: absolute;
    bottom: 0.5rem;
    left: 0.6rem;
    right: 0.6rem;
  }

  #team-card :global(.add-tag-btn) {
    background: none;
    border: 1px dashed rgba(var(--accent-rgb), 0.15);
    border-radius: 4px;
    color: var(--text-faint);
    font-size: 0.7rem;
    width: 20px;
    height: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: color 0.2s, border-color 0.2s;
  }

  #team-card :global(.add-tag-btn:hover) {
    color: var(--accent);
    border-color: rgba(var(--accent-rgb), 0.4);
  }

  #team-card :global(.role-select) {
    background: var(--bg);
    border: 1px solid rgba(var(--accent-rgb), 0.08);
    border-radius: 4px;
    color: var(--text-faint);
    font-size: 0.55rem;
    padding: 0.15rem 0.2rem;
    outline: none;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
    max-width: 80px;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
  }

  #team-card :global(.role-select option) {
    background: var(--bg);
    color: var(--text);
    font-size: 0.7rem;
    padding: 0.3rem;
  }

  #team-card :global(.role-select:hover) {
    border-color: rgba(var(--accent-rgb), 0.3);
    color: var(--text-muted);
  }

  #team-card :global(.role-select.active) {
    color: var(--accent);
    border-color: rgba(var(--accent-rgb), 0.5);
    background: rgba(var(--accent-rgb), 0.08);
  }

  /* ── Saved Teams Section ─────────────────────────────── */
  #saved-section {
    margin-top: 3rem;
    border-top: 1px solid rgba(var(--accent-rgb), 0.2);
    padding-top: 1.5rem;
  }

  #saved-section h2 {
    color: var(--accent);
    font-size: 1.1rem;
    margin: 0 0 1rem;
  }

  #delete-all-btn {
    background: none;
    border: 1px solid rgba(255, 80, 80, 0.5);
    color: #ff5050;
    border-radius: 6px;
    padding: 0.4rem 1rem;
    cursor: pointer;
    font-size: 0.8rem;
    margin-bottom: 1rem;
    transition: background 0.2s, color 0.2s;
  }

  #delete-all-btn:hover {
    background: #ff5050;
    color: var(--bg);
  }

  #saved-list :global(.empty) {
    color: var(--text-faint);
    font-style: italic;
  }

  #saved-list :global(.saved-item) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.8rem;
    border: 1px solid rgba(var(--accent-rgb), 0.08);
    border-radius: 6px;
    margin-bottom: 0.5rem;
  }

  #saved-list :global(.saved-name) {
    color: var(--text);
    font-size: 0.9rem;
  }

  #saved-list :global(.saved-actions) {
    display: flex;
    gap: 0.5rem;
  }

  #saved-list :global(.load-btn) {
    background: none;
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    color: var(--accent);
    border-radius: 4px;
    padding: 0.25rem 0.7rem;
    cursor: pointer;
    font-size: 0.75rem;
  }

  #saved-list :global(.load-btn:hover) {
    background: var(--accent);
    color: var(--bg);
  }

  #saved-list :global(.del-btn) {
    background: none;
    border: 1px solid rgba(255, 80, 80, 0.4);
    color: #ff5050;
    border-radius: 4px;
    padding: 0.25rem 0.7rem;
    cursor: pointer;
    font-size: 0.75rem;
  }

  #saved-list :global(.del-btn:hover) {
    background: #ff5050;
    color: var(--bg);
  }

  @media (max-width: 850px) {
    #team-card :global(.team-members) {
      grid-template-columns: repeat(2, minmax(150px, 200px));
    }
  }

  @media (max-width: 600px) {
    #team-card :global(.team-members) {
