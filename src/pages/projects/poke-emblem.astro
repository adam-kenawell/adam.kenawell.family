---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Poké Emblem — Tactical RPG"
  description="A browser-based tactical RPG combining Fire Emblem Awakening gameplay systems with Pokémon Mystery Dungeon: Explorers of Sky visuals."
>
  <div class="page">
    <Header />

    <main class="poke-emblem-shell">
      <div id="poke-emblem-root" class="pmd-viewport">
        <!-- Persistent Mobile / PC Menu & Back Button (Rule 2 & Rule 3) -->
        <button id="pmd-corner-menu-btn" class="pmd-window pmd-corner-btn" type="button" aria-label="Menu or Back">
          Menu / Back
        </button>

        <!-- Authentic PMD: Explorers of Sky Title Window -->
        <section class="pmd-window pmd-title-card">
          <div class="pmd-badge-row">
            <div id="pmd-bulbasaur-slot" class="pmd-sprite-slot" title="Click or tap Bulbasaur to attack!"></div>
            <div class="pmd-badge">DEV BUILD · STEP 0 SHELL</div>
          </div>
          <h1 class="pmd-title">POKÉ EMBLEM</h1>
          <p class="pmd-subtitle">Echoes of the Dragon Lineage</p>

          <p class="pmd-desc">
            Fire Emblem Awakening tactical grid combat meets Pokémon Mystery Dungeon: Explorers of Sky sprites, dungeon tilesets, and portraits.
          </p>

          <div class="pmd-actions">
            <button class="pmd-btn pmd-btn-primary" id="btn-new-game" type="button">
              New Campaign (Quiz)
            </button>
            <button class="pmd-btn" id="btn-continue" type="button" disabled>
              Continue Save (No Save Found)
            </button>
            <button class="pmd-btn" id="btn-cloud-sync" type="button">
              Google Cloud Save Sync
            </button>
          </div>

          <p id="pmd-status-msg" class="pmd-status">
            Ready to begin Step 1: Core Data Schemas, Manual Balance Registries &amp; SaveStateManager.
          </p>
        </section>
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<script>
  import { createSpriteWidget, resetSpriteWidgets } from '../../utils/sprite-utils';

  async function initPokeEmblemShell() {
    resetSpriteWidgets();
    const statusEl = document.getElementById('pmd-status-msg');
    const newGameBtn = document.getElementById('btn-new-game');
    const cloudBtn = document.getElementById('btn-cloud-sync');
    const menuBtn = document.getElementById('pmd-corner-menu-btn');
    const bulbasaurSlot = document.getElementById('pmd-bulbasaur-slot');

    if (bulbasaurSlot) {
      bulbasaurSlot.innerHTML = '';
      // Bulbasaur = National Dex #1
      const spriteCanvas = await createSpriteWidget(1, 2);
      if (spriteCanvas) {
        bulbasaurSlot.appendChild(spriteCanvas);
      }
    }

    newGameBtn?.addEventListener('pointerdown', () => {
      if (statusEl) {
        statusEl.textContent = 'Starting Quiz & SaveStateManager will be wired in Steps 1–3!';
      }
    });

    cloudBtn?.addEventListener('pointerdown', () => {
      if (statusEl) {
        statusEl.textContent = 'Firebase Google Auth + Cloud Firestore hybrid sync will be wired in Step 1!';
      }
    });

    menuBtn?.addEventListener('pointerdown', () => {
      if (statusEl) {
        statusEl.textContent = 'PMD System Menu / Back button triggered via unified Pointer Event.';
      }
    });
  }

  initPokeEmblemShell();
  document.addEventListener('astro:after-swap', initPokeEmblemShell);
</script>

<style>
  .poke-emblem-shell {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem 1rem;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .pmd-viewport {
    position: relative;
    width: 100%;
    min-height: 540px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 3.5rem 1.25rem 2rem;
    border-radius: 8px;
    background: radial-gradient(circle at center, rgba(24, 40, 72, 0.75) 0%, rgba(10, 14, 24, 0.92) 100%);
    border: 2px solid rgba(88, 200, 248, 0.35);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.65);
    user-select: none;
    touch-action: manipulation;
  }

  /* Authentic PMD: Explorers of Sky Double-Layered Window Frame (Rule 3) */
  .pmd-window {
    background: rgba(16, 24, 40, 0.92);
    border: 3px solid #48b8e8;
    outline: 2px solid #f8d048;
    outline-offset: -6px;
    border-radius: 6px;
    box-shadow:
      0 0 0 2px #102038,
      0 8px 28px rgba(0, 0, 0, 0.75),
      inset 0 0 18px rgba(72, 184, 232, 0.12);
    color: #f8f8f8;
    text-shadow: 1px 1px 0 #081020;
  }

  .pmd-corner-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    min-height: 44px;
    min-width: 110px;
    padding: 0.45rem 0.9rem;
    font-size: 0.8rem;
    color: #f8d048;
    cursor: pointer;
    z-index: 10;
    transition: transform 0.15s, background-color 0.15s;
  }

  .pmd-corner-btn:hover,
  .pmd-corner-btn:active {
    background: rgba(32, 52, 88, 0.96);
    transform: translateY(-1px);
  }

  .pmd-title-card {
    max-width: 560px;
    width: 100%;
    padding: 2rem 1.75rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .pmd-badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }

  .pmd-sprite-slot {
    min-width: 48px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pmd-badge {
    font-size: 0.7rem;
    color: #48b8e8;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.2rem 0.65rem;
    border: 1px solid rgba(72, 184, 232, 0.5);
    border-radius: 4px;
    background: rgba(8, 16, 32, 0.6);
  }

  .pmd-title {
    font-size: 2.1rem;
    color: #f8d048;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-shadow: 2px 2px 0 #102038, 0 0 14px rgba(248, 208, 72, 0.35);
  }

  .pmd-subtitle {
    font-size: 0.95rem;
    color: #90d8f8;
    margin-top: -0.4rem;
  }

  .pmd-desc {
    font-size: 0.85rem;
    color: rgba(248, 248, 248, 0.88);
    line-height: 1.6;
    max-width: 460px;
  }

  .pmd-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 340px;
    margin-top: 0.5rem;
  }

  .pmd-btn {
    min-height: 46px;
    padding: 0.6rem 1.1rem;
    background: rgba(24, 40, 68, 0.95);
    border: 2px solid #48b8e8;
    border-radius: 4px;
    color: #f8f8f8;
    font-size: 0.85rem;
    cursor: pointer;
    text-shadow: 1px 1px 0 #081020;
    transition: background-color 0.15s, border-color 0.15s, transform 0.15s;
  }

  .pmd-btn:hover:not(:disabled),
  .pmd-btn:active:not(:disabled) {
    background: rgba(44, 76, 124, 0.98);
    border-color: #f8d048;
    color: #f8d048;
    transform: translateY(-1px);
  }

  .pmd-btn-primary {
    border-color: #f8d048;
    color: #f8d048;
  }

  .pmd-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .pmd-status {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: #90d8f8;
    padding: 0.5rem 0.75rem;
    border-top: 1px solid rgba(72, 184, 232, 0.3);
    width: 100%;
  }

  @media (max-width: 600px) {
    .poke-emblem-shell {
      padding: 0.75rem 0.5rem;
    }

    .pmd-viewport {
      min-height: 480px;
      padding: 3.75rem 0.75rem 1.25rem;
    }

    .pmd-title-card {
      padding: 1.5rem 1.1rem;
    }

    .pmd-title {
      font-size: 1.55rem;
    }
  }
</style>
