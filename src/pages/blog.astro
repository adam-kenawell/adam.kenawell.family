---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const base = import.meta.env.BASE_URL;

// Set to true when you have real blog posts to show
const showPosts = false;
---

<Layout title="Blog — Adam Kenawell">
  <div class="page">
    <Header />

    <div class="post-list">
      {showPosts && posts.length > 0 ? (
        posts.map((post) => (
          <a class="post-card" href={`${base}blog/${post.id}`}>
            <time>{post.data.date.toISOString().slice(0, 10)}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.excerpt}</p>
          </a>
        ))
      ) : (
        <div class="empty-state">
          <p>nothing to see here!</p>
          <p class="sub">looks like someone's been slacking on their blog posts!</p>
        </div>
      )}
    </div>

    <Footer />
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .post-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2.5rem 2rem;
    max-width: 720px;
    width: 100%;
    margin: 0 auto;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(245, 208, 0, 0.3) transparent;
  }

  .post-list::-webkit-scrollbar {
    width: 6px;
  }

  .post-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .post-list::-webkit-scrollbar-thumb {
    background-color: rgba(245, 208, 0, 0.3);
    border-radius: 3px;
  }

  .post-card {
    display: block;
    padding: 1.5rem;
    border: 2px solid rgba(245, 208, 0, 0.5);
    border-radius: 8px;
    background-color: rgba(26, 26, 26, 0.9);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    text-decoration: none;
    color: #f5d000;
    transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(245, 208, 0, 0.2), 0 4px 12px rgba(0, 0, 0, 0.3);
    background-color: rgba(255, 255, 255, 0.1);
  }

  .post-card time {
    font-size: 0.75rem;
    opacity: 0.5;
  }

  .post-card h2 {
    font-size: 1.1rem;
    margin: 0.4rem 0;
  }

  .post-card p {
    font-size: 0.85rem;
    opacity: 0.7;
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .post-list {
      padding: 1.5rem 1rem;
    }

    .post-card {
      padding: 1.1rem;
    }

    .post-card h2 {
      font-size: 0.95rem;
    }
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    opacity: 0.7;
  }

  .empty-state p {
    font-size: 1.2rem;
  }

  .empty-state .sub {
    font-size: 0.85rem;
    margin-top: 0.5rem;
    opacity: 0.6;
  }
</style>
