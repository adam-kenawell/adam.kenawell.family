---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const experience = [
  {
    role: 'Agentic AI Data Engineer',
    company: 'Ford Motor Company',
    period: 'Sep 2023 — Present',
    bullets: [
      'Designed and maintained scalable data pipelines using GCP BigQuery, Vertex AI, dbt Core, and Astronomer Airflow',
      'Led the onboarding of new data sources into the Digital Birth Certificate (DBC) product, enhancing vehicle manufacturing insights',
      'Contributed to an AI solution that saved Ford over $68M in its initial two months of operation',
    ],
  },
  {
    role: 'Data Engineering Intern',
    company: 'Ford Motor Company',
    period: 'May 2021 — Aug 2021',
    bullets: [
      'Developed a notification manager for data pipelines within the quality.ai team at Ford Motor Company',
      'Created and maintained a data pipeline for root cause analysis in vehicle manufacturing',
      'Collaborated with cross-functional teams to enhance data processing efficiency and reliability',
    ],
  },
  {
    role: 'Bioinformatics Intern',
    company: 'Hillman Cancer Center',
    period: 'Jun 2019 — Apr 2020',
    bullets: [
      'Conducted cancer research at a state-of-the-art oncology research facility, contributing to early-stage scientific exploration',
      'Coded and debugged molecular visualization software designed to simulate complex molecule interactions for research analysis',
      'Selected as 1 of only 2 students (out of ~250) from one of Pennsylvania\'s highest-performing high schools to participate in this competitive research opportunity',
    ],
  },
];

const education = [
  { degree: 'M.S. in Data Science', school: 'Bellevue University', period: 'In Progress, 2025–2028', detail: 'GPA: 4.0' },
  { degree: 'B.S. in Data Science, Minor in Mathematics', school: 'The Pennsylvania State University', period: '2019–2023', detail: 'GPA: 3.65' },
];

const achievements = [
  { name: '"Moving the Business Forward" Award — Ford Motor Company', period: 'Mar 2026' },
  { name: 'Best Overall — Penn State Data Science Hackathon', period: 'Apr 2023' },
  { name: 'Intern City of Tomorrow Challenge: Future Mobility — High Achiever', period: 'Aug 2022' },
  { name: 'Computer Science Departmental Award — South Fayette School District', period: 'Jun 2019' },
  { name: 'Eagle Scout Award — Boy Scouts of America', period: 'May 2018' },
];

const skillGroups = [
  { label: 'Cloud & Data', items: ['GCP', 'BigQuery', 'Vertex AI', 'dbt Core', 'Astronomer Airflow'] },
  { label: 'Languages & AI', items: ['Python', 'SQL', 'Prompt Engineering', 'Agentic AI', 'Anthropic Claude API'] },
  { label: 'Analytics & Tools', items: ['Statistics', 'Data Pipeline Design', 'Root Cause Analysis', 'Git', 'Bioinformatics'] },
];
---

<Layout title="R&#233;sum&#233; — Adam Kenawell">
  <div class="page">
    <Header />

    <main>
      <a href={`${import.meta.env.BASE_URL}Adam_Kenawell_Resume.html`} download class="download-link">⬇ Download One-Page Résumé</a>

      <section>
        <h2>Objective</h2>
        <p class="objective">Data Engineer with hands-on experience building agentic AI solutions, scalable data pipelines, and predictive models. Passionate about applying AI innovation to drive measurable impact at scale.</p>
      </section>

      <section>
        <h2>Experience</h2>
        {experience.map((job) => (
          <div class="card">
            <div class="card-header">
              <strong>{job.role}</strong>
              <span class="period">{job.period}</span>
            </div>
            <span class="company">{job.company}</span>
            <ul>
              {job.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Education</h2>
        {education.map((edu) => (
          <div class="card">
            <div class="card-header">
              <strong>{edu.degree}</strong>
              <span class="period">{edu.period}</span>
            </div>
            <span class="company">{edu.school}</span>
            <span class="detail">{edu.detail}</span>
          </div>
        ))}
      </section>

      <section>
        <h2>Achievements</h2>
        <div class="card">
          <ul class="achievements-list">
            {achievements.map((a) => (
              <li>
                <span><span class="achievement-title">{a.name.split(' — ')[0]}</span> — {a.name.split(' — ')[1]}</span>
                <span class="period">{a.period}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section>
        <h2>Technical Skills</h2>
        {skillGroups.map((group) => (
          <div class="skill-group">
            <h3>{group.label}</h3>
            <div class="skills">
              {group.items.map((skill) => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
        ))}
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2.5rem 2rem;
    max-width: 720px;
    width: 100%;
    margin: 0 auto;
  }

  .download-link {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 2px solid rgba(245, 208, 0, 0.5);
    border-radius: 6px;
    background-color: rgba(26, 26, 26, 0.9);
    color: #f5d000;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background-color 0.2s, box-shadow 0.2s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .download-link:hover {
    background-color: rgba(245, 208, 0, 0.1);
    box-shadow: 0 4px 12px rgba(245, 208, 0, 0.2);
  }

  .objective {
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h2 {
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-top: 1.5rem;
    padding-bottom: 0.6rem;
    border-top: 1px solid rgba(245, 208, 0, 0.2);
    border-bottom: none;
    margin-bottom: 0.25rem;
  }

  section:first-child h2 {
    border-top: none;
    padding-top: 0;
  }

  h3 {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .card {
    padding: 1.25rem;
    border: 2px solid rgba(245, 208, 0, 0.5);
    border-radius: 8px;
    background-color: rgba(26, 26, 26, 0.9);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .period {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .company {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    display: block;
    margin: 0.25rem 0 0.75rem;
  }

  .detail {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    display: block;
    margin-top: 0.25rem;
  }

  .card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card li {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }

  .card li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: #f5d000;
    opacity: 0.6;
  }

  .achievements-list li {
    padding-left: 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .achievements-list li::before {
    content: '★';
  }

  .achievement-title {
    color: #f5d000;
  }

  .skill-group {
    margin-bottom: 0.75rem;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .skill-tag {
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(245, 208, 0, 0.5);
    border-radius: 6px;
    background-color: rgba(26, 26, 26, 0.9);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.85);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 600px) {
    main {
      padding: 1.5rem 1rem;
      gap: 2rem;
    }

    .card {
      padding: 1rem;
    }

    .card-header {
      flex-direction: column;
      gap: 0.2rem;
    }

    .skill-tag {
      font-size: 0.7rem;
      padding: 0.25rem 0.5rem;
    }
  }
</style>
