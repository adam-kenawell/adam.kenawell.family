---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const experience = [
  {
    role: 'Data Engineer',
    company: 'Ford Motor Company',
    period: 'May 2022 — Present',
    bullets: [
      'Design and maintain scalable data pipelines using GCP BigQuery, Vertex AI, dbt Core, and Astronomer Airflow for internal analytics products',
      'Lead onboarding of new data sources into DBC (Digital Birth Certificate), an agentic AI product that resolves vehicle manufacturing root-cause issues',
      'Contributed to agentic AI solution that saved Ford an estimated $68M+ in its first two months of operation (Feb–Mar 2026)',
      'Personally drove $5M+ in cost savings through AI-powered automation and analytics in March 2026',
      'Collaborate cross-functionally with engineering, product, and business teams to translate complex requirements into data-driven solutions',
      'Apply prompt engineering techniques with Anthropic Claude API and Vertex AI to optimize AI agent performance',
    ],
  },
];

const education = [
  { degree: 'M.S. in Data Science', school: 'Bellevue University', period: 'In Progress, 2025–2028', detail: 'GPA: 4.0' },
  { degree: 'B.S. in Data Science, Minor in Mathematics', school: 'The Pennsylvania State University', period: '2019–2023', detail: 'GPA: 3.65' },
];

const achievements = [
  '"Moving the Business Forward" Award — Ford Motor Company (2026)',
  'Best Overall — Penn State Data Science Hackathon (2023)',
  'Computer Science Departmental Award — South Fayette School District (2019)',
];

const skillGroups = [
  { label: 'Cloud & Data', items: ['GCP', 'BigQuery', 'Dataflow', 'Vertex AI', 'dbt Core', 'Astronomer Airflow', 'Looker Studio'] },
  { label: 'Languages & AI', items: ['Python', 'SQL', 'R', 'Prompt Engineering', 'Anthropic Claude API', 'Agentic AI', 'Generative AI', 'NLP'] },
  { label: 'Analytics & Tools', items: ['Microsoft Power BI', 'Statistics', 'Mathematics', 'Git', 'Jupyter'] },
];
---

<Layout title="Resume — Adam Kenawell">
  <div class="page">
    <Header />

    <main>
      <div class="intro">
        <p>Data Engineer with hands-on experience building agentic AI solutions, scalable data pipelines, and predictive models. Passionate about applying AI innovation to drive measurable impact at scale.</p>
      </div>

      <section>
        <h2>Experience</h2>
        {experience.map((job) => (
          <div class="card">
            <div class="card-header">
              <strong>{job.role}</strong>
              <span class="period">{job.period}</span>
            </div>
            <span class="company">{job.company}</span>
            <ul>
              {job.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Education</h2>
        {education.map((edu) => (
          <div class="card">
            <div class="card-header">
              <strong>{edu.degree}</strong>
              <span class="period">{edu.period}</span>
            </div>
            <span class="company">{edu.school}</span>
            <span class="detail">{edu.detail}</span>
          </div>
        ))}
      </section>

      <section>
        <h2>Achievements</h2>
        <div class="card">
          <ul class="achievements-list">
            {achievements.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      </section>

      <section>
        <h2>Technical Skills</h2>
        {skillGroups.map((group) => (
          <div class="skill-group">
            <h3>{group.label}</h3>
            <div class="skills">
              {group.items.map((skill) => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
        ))}
      </section>
    </main>

    <footer>
      <span>&copy; 2026 Adam Kenawell</span>
    </footer>
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding: 2.5rem 2rem;
    max-width: 720px;
    width: 100%;
    margin: 0 auto;
  }

  .intro p {
    font-size: 0.9rem;
    line-height: 1.6;
    opacity: 0.8;
    text-align: center;
    padding: 0 1rem;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h2 {
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid rgba(245, 208, 0, 0.4);
    margin-bottom: 0.25rem;
  }

  h3 {
    font-size: 0.8rem;
    opacity: 0.6;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .card {
    padding: 1.25rem;
    border: 2px solid rgba(245, 208, 0, 0.5);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .period {
    font-size: 0.75rem;
    opacity: 0.5;
  }

  .company {
    font-size: 0.85rem;
    opacity: 0.7;
    display: block;
    margin: 0.25rem 0 0.75rem;
  }

  .detail {
    font-size: 0.8rem;
    opacity: 0.5;
    display: block;
    margin-top: 0.25rem;
  }

  .card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card li {
    font-size: 0.85rem;
    opacity: 0.7;
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }

  .card li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: #f5d000;
    opacity: 0.6;
  }

  .achievements-list li {
    padding-left: 1.2rem;
  }

  .achievements-list li::before {
    content: '★';
  }

  .skill-group {
    margin-bottom: 0.75rem;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .skill-tag {
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(245, 208, 0, 0.5);
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.06);
    font-size: 0.8rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  footer {
    text-align: center;
    padding: 1.5rem;
    font-size: 0.75rem;
    opacity: 0.6;
  }
</style>
