---
import '@fontsource/fusion-pixel-12px-monospaced-kr';
import SpriteBackground from '../components/SpriteBackground.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <SpriteBackground />
    <div id="page-content">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    height: 100%;
  }

  body {
    font-family: 'Fusion Pixel 12px Monospaced KR', monospace;
    background-color: #1a1a1a;
    color: #f5d000;
  }

  a {
    color: #f5d000;
    text-decoration: none;
  }

  a:hover {
    color: #fff;
  }

  #page-content {
    position: relative;
    z-index: 2;
  }
</style>
