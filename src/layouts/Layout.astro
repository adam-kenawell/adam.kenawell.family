---
import '@fontsource/fusion-pixel-12px-proportional-kr';
import { ClientRouter } from 'astro:transitions';
import SpriteBackground from '../components/SpriteBackground.astro';
import ThemeControls from '../components/ThemeControls.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal website of Adam Kenawell — Data Engineer at Ford. Blog, projects, and more.' } = Astro.props;
const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="Adam Kenawell — Blog" href={`${import.meta.env.BASE_URL}rss.xml`} />
    <ClientRouter />
    <title>{title}</title>
    <!-- Theme init: apply saved theme before paint to prevent flash -->
    <script is:inline>
      (function() {
        function applyStoredTheme() {
          var t = localStorage.getItem('theme-mode') || 'dark';
          var a = localStorage.getItem('theme-accent') || '245,208,0';
          var r = document.documentElement;
          r.setAttribute('data-theme', t);
          r.style.setProperty('--accent-rgb', a);
          r.style.setProperty('--accent', 'rgb(' + a + ')');
          if (t === 'light') {
            r.style.setProperty('--bg', '#f5f5f5');
            r.style.setProperty('--bg-rgb', '245,245,245');
            r.style.setProperty('--bg-card', 'rgba(255,255,255,0.9)');
            r.style.setProperty('--text', 'rgba(30,30,30,0.9)');
            r.style.setProperty('--text-muted', 'rgba(30,30,30,0.55)');
            r.style.setProperty('--text-faint', 'rgba(30,30,30,0.35)');
            r.style.setProperty('--header-bg', 'rgba(245,245,245,0.9)');
          } else {
            r.style.setProperty('--bg', '#1a1a1a');
            r.style.setProperty('--bg-rgb', '26,26,26');
            r.style.setProperty('--bg-card', 'rgba(26,26,26,0.9)');
            r.style.setProperty('--text', 'rgba(255,255,255,0.85)');
            r.style.setProperty('--text-muted', 'rgba(255,255,255,0.5)');
            r.style.setProperty('--text-faint', 'rgba(255,255,255,0.35)');
            r.style.setProperty('--header-bg', 'rgba(26,26,26,0.9)');
          }
        }
        applyStoredTheme();
        document.addEventListener('astro:after-swap', applyStoredTheme);
      })();
    </script>
  </head>
  <body>
    <SpriteBackground />
    <ThemeControls />
    <div id="page-content">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --accent-rgb: 245, 208, 0;
    --accent: rgb(var(--accent-rgb));
    --bg: #1a1a1a;
    --bg-rgb: 26, 26, 26;
    --bg-card: rgba(26, 26, 26, 0.9);
    --text: rgba(255, 255, 255, 0.85);
    --text-muted: rgba(255, 255, 255, 0.5);
    --text-faint: rgba(255, 255, 255, 0.35);
    --header-bg: rgba(26, 26, 26, 0.9);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    height: 100%;
  }

  body {
    font-family: 'Fusion Pixel 12px Proportional KR', sans-serif;
    background-color: var(--bg);
    color: var(--accent);
    line-height: 1.8;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    color: #fff;
  }

  [data-theme="light"] a:hover {
    color: #000;
  }

  #page-content {
    position: relative;
    z-index: 2;
  }
</style>
