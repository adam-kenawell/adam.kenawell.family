---
interface Props {
  showNav?: boolean;
}

const { showNav = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
  <div class="left-group">
    <a class="name-btn" href={base}>Adam Kenawell</a>
    <a class:list={['nav-link', 'about-link', { active: currentPath === '/about' }]} href={`${base}about`}>About Me</a>
  </div>
  <nav>
    {showNav && (
      <>
        <a class:list={['nav-link', { active: currentPath.startsWith('/blog') }]} href={`${base}blog`}>Blog</a>
        <a class:list={['nav-link', { active: currentPath === '/resume' }]} href={`${base}resume`}>R&#233;sum&#233;</a>
        <a class:list={['nav-link', { active: currentPath === '/projects' }]} href={`${base}projects`}>Projects</a>
      </>
    )}
    <a class="github-link" href="https://github.com/adam-kenawell" target="_blank" rel="noopener">GitHub ↗</a>
    <a class="github-link" href="https://www.linkedin.com/in/adam-kenawell/" target="_blank" rel="noopener">LinkedIn ↗</a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background-color: rgba(26, 26, 26, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(245, 208, 0, 0.4);
    box-shadow: 0 2px 12px rgba(245, 208, 0, 0.08);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .left-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .name-btn {
    font-size: 1rem;
    letter-spacing: 0.05em;
    border: 1px solid rgba(245, 208, 0, 0.5);
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    color: #f5d000;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .name-btn:hover {
    background-color: #f5d000;
    color: #1a1a1a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(245, 208, 0, 0.25);
  }

  nav {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-link,
  .about-link {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .nav-link:hover,
  .about-link:hover {
    color: rgba(255, 255, 255, 1);
  }

  .nav-link.active,
  .about-link.active {
    color: #f5d000;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .github-link {
    font-size: 0.8rem;
    border: 1px solid rgba(245, 208, 0, 0.5);
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    color: #f5d000;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .github-link:hover {
    background-color: #f5d000;
    color: #1a1a1a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(245, 208, 0, 0.25);
  }

  @media (max-width: 600px) {
    header {
      padding: 0.5rem 0.75rem;
      flex-wrap: nowrap;
      gap: 0.4rem;
    }

    .left-group {
      gap: 0.4rem;
    }

    .name-btn {
      font-size: 0.7rem;
      padding: 0.25rem 0.4rem;
    }

    .about-link {
      font-size: 0.55rem;
    }

    .github-link {
      font-size: 0.6rem;
      padding: 0.2rem 0.4rem;
    }

    .nav-link {
      font-size: 0.55rem;
    }

    nav {
      gap: 0.4rem;
    }
  }
</style>
