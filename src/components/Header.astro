---
interface Props {
  showNav?: boolean;
}

const { showNav = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header>
  <a class="name-btn" href={base}>Adam Kenawell</a>
  <nav>
    {showNav && (
      <>
        <a class="nav-link" href={`${base}blog`}>Blog</a>
        <a class="nav-link" href={`${base}resume`}>Resume</a>
        <a class="nav-link" href={`${base}projects`}>Projects</a>
      </>
    )}
    <a class="github-link" href="https://github.com/adam-kenawell" target="_blank" rel="noopener">GitHub ↗</a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    background-color: rgba(26, 26, 26, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(245, 208, 0, 0.4);
    box-shadow: 0 2px 12px rgba(245, 208, 0, 0.08);
  }

  .name-btn {
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    border: 1px solid rgba(245, 208, 0, 0.5);
    border-radius: 6px;
    padding: 0.4rem 0.8rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    color: #f5d000;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .name-btn:hover {
    background-color: #f5d000;
    color: #1a1a1a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(245, 208, 0, 0.25);
  }

  nav {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .nav-link {
    font-size: 0.75rem;
    color: #f5d000;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .nav-link:hover {
    opacity: 1;
  }

  .github-link {
    font-size: 0.9rem;
    border: 1px solid rgba(245, 208, 0, 0.5);
    border-radius: 6px;
    padding: 0.4rem 0.8rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    color: #f5d000;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .github-link:hover {
    background-color: #f5d000;
    color: #1a1a1a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(245, 208, 0, 0.25);
  }
</style>
