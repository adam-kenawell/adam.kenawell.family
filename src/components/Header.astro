---
interface Props {
  showNav?: boolean;
}

const { showNav = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
  <div class="left-group">
    <div class="avatar-wrapper">
      <canvas id="avatar-sprite" width="40" height="40" title="Click me!"></canvas>
      <div id="status-bubble" class="status-bubble hidden">
        <div class="status-arrow"></div>
        <p class="status-text">fixing data pipelines and pretending to be a web developer</p>
      </div>
    </div>
    <a class="name-btn" href={base}>Adam Kenawell</a>
    <a class:list={['nav-link', 'about-link', { active: currentPath === '/about' }]} href={`${base}about`}>About Me</a>
  </div>
  <nav>
    {showNav && (
      <>
        <a class:list={['nav-link', { active: currentPath.startsWith('/blog') }]} href={`${base}blog`}>Blog</a>
        <a class:list={['nav-link', { active: currentPath === '/resume' }]} href={`${base}resume`}>R&#233;sum&#233;</a>
        <a class:list={['nav-link', { active: currentPath === '/projects' }]} href={`${base}projects`}>Projects</a>
      </>
    )}
    <a class="github-link" href="https://github.com/adam-kenawell" target="_blank" rel="noopener">GitHub ↗</a>
    <a class="github-link" href="https://www.linkedin.com/in/adam-kenawell/" target="_blank" rel="noopener">LinkedIn ↗</a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background-color: var(--header-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.4);
    box-shadow: 0 2px 12px rgba(var(--accent-rgb), 0.08);
    gap: 0.5rem;
  }

  .left-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .name-btn {
    font-size: 1rem;
    letter-spacing: 0.05em;
    border: 1px solid rgba(var(--accent-rgb), 0.5);
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .name-btn:hover {
    background-color: var(--accent);
    color: var(--bg);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(var(--accent-rgb), 0.25);
  }

  nav {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  nav::-webkit-scrollbar {
    display: none;
  }

  .nav-link,
  .about-link {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .nav-link:hover,
  .about-link:hover {
    color: var(--text);
  }

  .nav-link.active,
  .about-link.active {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .github-link {
    font-size: 0.8rem;
    border: 1px solid rgba(var(--accent-rgb), 0.5);
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .github-link:hover {
    background-color: var(--accent);
    color: var(--bg);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(var(--accent-rgb), 0.25);
  }

  .avatar-wrapper {
    position: relative;
    flex-shrink: 0;
    cursor: pointer;
  }

  #avatar-sprite {
    display: block;
    image-rendering: pixelated;
    height: 40px;
    width: auto;
  }

  .status-bubble {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 200px;
    max-width: 260px;
    padding: 0.6rem 0.8rem;
    background: var(--bg-card);
    border: 1px solid rgba(var(--accent-rgb), 0.5);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    z-index: 200;
    animation: bubble-in 0.15s ease-out;
  }

  .status-bubble.hidden {
    display: none;
  }

  .status-arrow {
    position: absolute;
    top: -6px;
    left: 14px;
    width: 10px;
    height: 10px;
    background: var(--bg-card);
    border-left: 1px solid rgba(var(--accent-rgb), 0.5);
    border-top: 1px solid rgba(var(--accent-rgb), 0.5);
    transform: rotate(45deg);
  }

  .status-text {
    font-size: 0.7rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }

  @keyframes bubble-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 600px) {
    header {
      padding: 0.5rem 0.75rem;
      flex-wrap: nowrap;
      gap: 0.4rem;
    }

    .left-group {
      gap: 0.4rem;
    }

    #avatar-sprite {
      height: 32px;
    }

    .status-bubble {
      min-width: 160px;
      max-width: 200px;
    }

    .name-btn {
      font-size: 0.7rem;
      padding: 0.25rem 0.4rem;
    }

    .about-link {
      font-size: 0.55rem;
    }

    .github-link {
      font-size: 0.6rem;
      padding: 0.2rem 0.4rem;
    }

    .nav-link {
      font-size: 0.55rem;
    }

    nav {
      gap: 0.4rem;
    }
  }
</style>

<script>
  const ELECTIVIRE_ID = 466;
  const SPRITE_BASE = 'https://raw.githubusercontent.com/PMDCollab/SpriteCollab/master/sprite';
  const padId = String(ELECTIVIRE_ID).padStart(4, '0');
  const sheetUrl = `${SPRITE_BASE}/${padId}/Idle-Anim.png`;
  const animDataUrl = `${SPRITE_BASE}/${padId}/AnimData.xml`;

  function initAvatar() {
    const canvas = document.getElementById('avatar-sprite') as HTMLCanvasElement | null;
    const bubble = document.getElementById('status-bubble');
    if (!canvas || !bubble) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Toggle status bubble
    canvas.addEventListener('click', (e) => {
      e.stopPropagation();
      bubble.classList.toggle('hidden');
    });
    document.addEventListener('click', () => bubble.classList.add('hidden'));

    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = async () => {
      // Parse AnimData for frame dimensions
      let fw = 0, fh = 0;
      try {
        const res = await fetch(animDataUrl);
        const text = await res.text();
        const doc = new DOMParser().parseFromString(text, 'text/xml');
        const anims = doc.querySelectorAll('Anim');
        for (const anim of anims) {
          if (anim.querySelector('Name')?.textContent === 'Idle') {
            fw = parseInt(anim.querySelector('FrameWidth')?.textContent ?? '0', 10);
            fh = parseInt(anim.querySelector('FrameHeight')?.textContent ?? '0', 10);
            break;
          }
        }
      } catch { /* fallback below */ }

      if (!fw || !fh) {
        fh = Math.floor(img.naturalHeight / 8);
        fw = fh;
      }

      const frameCount = Math.max(1, Math.floor(img.naturalWidth / fw));
      const row = 0; // face down
      let frame = 0;
      const FRAME_INTERVAL = 150;

      // Crop: cut off the bottom 15% (feet/empty space)
      const cropH = Math.floor(fh * 0.70);
      canvas.width = fw;
      canvas.height = cropH;

      function draw() {
        ctx!.clearRect(0, 0, fw, cropH);
        ctx!.drawImage(img, frame * fw, row * fh, fw, cropH, 0, 0, fw, cropH);
      }

      draw();
      setInterval(() => {
        frame = (frame + 1) % frameCount;
        draw();
      }, FRAME_INTERVAL);

      // Animated favicon
      setupFavicon(img, fw, fh, frameCount);
    };
    img.src = sheetUrl;
  }

  function setupFavicon(img: HTMLImageElement, fw: number, fh: number, frameCount: number) {
    const size = 32;
    const srcH = Math.floor(fh * 0.60);
    // Crop-to-fill: scale up to cover the square, then center-crop
    const scale = Math.max(size / fw, size / srcH);
    const sw = Math.round(size / scale); // source width to sample
    const sh = Math.round(size / scale); // source height to sample
    const sox = Math.round((fw - sw) / 2) - 1; // nudge left
    const soy = Math.round((srcH - sh) / 2); // center vertically

    const favCanvas = document.createElement('canvas');
    favCanvas.width = size;
    favCanvas.height = size;
    const fCtx = favCanvas.getContext('2d');
    if (!fCtx) return;
    fCtx.imageSmoothingEnabled = false;

    let link = document.querySelector('link[rel="icon"]') as HTMLLinkElement | null;
    if (!link) {
      link = document.createElement('link');
      link.rel = 'icon';
      document.head.appendChild(link);
    }
    link.type = 'image/png';

    let frame = 0;
    const row = 0;

    function drawFav() {
      fCtx!.clearRect(0, 0, size, size);
      fCtx!.drawImage(img, frame * fw + sox, row * fh + soy, sw, sh, 0, 0, size, size);
      link!.href = favCanvas.toDataURL('image/png');
      frame = (frame + 1) % frameCount;
    }

    drawFav();
    setInterval(drawFav, 150);
  }

  // Run on initial load and after view transitions
  initAvatar();
  document.addEventListener('astro:after-swap', initAvatar);
</script>
