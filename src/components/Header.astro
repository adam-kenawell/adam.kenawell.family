---
interface Props {
  showNav?: boolean;
}

const { showNav = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
  <div class="left-group">
    <div class="avatar-wrapper">
      <button class="avatar-btn accent-btn" id="avatar-btn" title="Click me!">
        <canvas id="avatar-sprite" width="32" height="32"></canvas>
      </button>
      <div id="status-bubble" class="status-bubble hidden">
        <div class="status-arrow"></div>
        <p class="status-text">fixing data pipelines and pretending to be a web developer</p>
      </div>
    </div>
    <a class="accent-btn name-btn" href={base}>Adam Kenawell</a>
    <a class:list={['nav-link', 'about-link', { active: currentPath.startsWith('/blog/about-me') }]} href={`${base}blog/about-me`}>About Me</a>
  </div>
  <div class="right-group">
    <div class="nav-links">
      {showNav && (
        <>
          <a class:list={['nav-link', { active: currentPath.startsWith('/blog') }]} href={`${base}blog`}>Blog</a>
          <a class:list={['nav-link', { active: currentPath === '/resume' }]} href={`${base}resume`}>Resum&#233;</a>
          <a class:list={['nav-link', { active: currentPath === '/projects' }]} href={`${base}projects`}>Projects</a>
        </>
      )}
      <a class="accent-btn github-link" href="https://github.com/adam-kenawell" target="_blank" rel="noopener">GitHub ↗</a>
      <a class="accent-btn github-link" href="https://www.linkedin.com/in/adam-kenawell/" target="_blank" rel="noopener">LinkedIn ↗</a>
      <a class="accent-btn github-link coffee-link" href="https://buymeacoffee.com/adam.kenawell" target="_blank" rel="noopener noreferrer">Buy me a coffee!</a>
    </div>
    <div class="settings-wrapper">
      <button class="accent-btn settings-btn" id="settings-btn" title="Settings">⚙</button>
      <div class="settings-dropdown" id="settings-dropdown" style="display:none;">
        <div class="settings-group">
          <span class="settings-group-title" id="pokemon-title" role="button" tabindex="0">Pok&#233;mon Controls</span>
          <div class="settings-group-content" id="pokemon-content" style="display:none;">
            <div class="settings-row" id="sprite-controls-row">
              <input id="sprite-dex-input" type="number" min="1" placeholder="Dex #" />
              <button id="sprite-swap-btn" class="accent-btn settings-action-btn" title="Spawn a new Pokémon">⟳ Spawn</button>
              <button id="sprite-toggle-btn" class="accent-btn settings-action-btn" title="Toggle Pokémon visibility">Show</button>
            </div>
          </div>
        </div>
        <div class="settings-group">
          <span class="settings-group-title" id="theme-title" role="button" tabindex="0">Theme</span>
          <div class="settings-group-content" id="theme-content" style="display:none;">
            <div class="settings-section">
              <span class="settings-label">Mode</span>
              <div class="mode-toggle">
                <button id="mode-dark" class="mode-btn active" title="Dark mode">Dark</button>
                <button id="mode-light" class="mode-btn" title="Light mode">Light</button>
              </div>
            </div>
            <div class="settings-section">
              <span class="settings-label">Accent</span>
              <div class="color-grid" id="color-grid"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header><style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background-color: var(--header-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.4);
    box-shadow: 0 2px 12px rgba(var(--accent-rgb), 0.08);
    gap: 0.5rem;
  }

  .left-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .name-btn {
    font-size: 1rem;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.7rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .name-btn:hover {
    box-shadow: 0 4px 12px rgba(var(--accent-rgb), 0.25);
  }

  .right-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 1;
    min-width: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-link,
  .about-link {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .nav-link:hover,
  .about-link:hover {
    color: var(--text);
  }

  .nav-link.active,
  .about-link.active {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .github-link {
    font-size: 0.8rem;
    padding: 0.3rem 0.6rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .github-link:hover {
    box-shadow: 0 4px 12px rgba(var(--accent-rgb), 0.25);
  }

  .avatar-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .avatar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem;
  }

  .avatar-btn:hover {
    background-color: rgba(var(--accent-rgb), 0.15);
  }

  #avatar-sprite {
    display: block;
    image-rendering: pixelated;
    height: 32px;
    width: auto;
  }

  .status-bubble {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 200px;
    max-width: 260px;
    padding: 0.6rem 0.8rem;
    background: var(--bg-card);
    border: 1px solid rgba(var(--accent-rgb), 0.5);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    z-index: 200;
    animation: bubble-in 0.15s ease-out;
  }

  .status-bubble.hidden {
    display: none;
  }

  .status-arrow {
    position: absolute;
    top: -6px;
    left: 14px;
    width: 10px;
    height: 10px;
    background: var(--bg-card);
    border-left: 1px solid rgba(var(--accent-rgb), 0.5);
    border-top: 1px solid rgba(var(--accent-rgb), 0.5);
    transform: rotate(45deg);
  }

  .status-text {
    font-size: 0.7rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }

  .coffee-link {
    border-color: rgba(var(--accent-rgb), 0.3);
    font-size: 0.7rem;
  }

  .settings-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .settings-btn {
    font-size: 1.1rem;
    padding: 0.2rem 0.5rem;
  }

  .settings-btn:hover {
    background-color: var(--accent);
    color: var(--bg);
  }

  .settings-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 210px;
    padding: 0.75rem;
    background: var(--bg-card);
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 8px;
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    z-index: 200;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    animation: bubble-in 0.15s ease-out;
  }

  .settings-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.15);
    padding-bottom: 0.5rem;
  }

  .settings-group:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .settings-group-title {
    font-size: 0.75rem;
    color: var(--text-muted);
    cursor: pointer;
    user-select: none;
    transition: color 0.2s;
    padding: 0.15rem 0;
  }

  .settings-group-title:hover {
    color: var(--accent);
  }

  .settings-group-content {
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 0.25rem;
    width: 100%;
  }

  .settings-section {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
  }

  .settings-label {
    font-size: 0.6rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .settings-row {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }

  #sprite-dex-input {
    width: 3.5rem;
    padding: 0.3rem 0.35rem;
    border: 1px solid rgba(var(--accent-rgb), 0.5);
    border-radius: 6px;
    background: var(--bg-card);
    color: var(--text);
    font-size: 0.8rem;
    outline: none;
  }

  #sprite-dex-input::placeholder {
    color: var(--text-faint);
  }

  #sprite-dex-input:focus {
    border-color: var(--accent);
  }

  .settings-action-btn {
    padding: 0.3rem 0.65rem;
    background: var(--bg-card);
    font-size: 0.8rem;
  }

  .settings-action-btn:hover {
    border-color: var(--accent);
  }

  .mode-toggle {
    display: flex;
    gap: 0.3rem;
  }

  .mode-btn {
    flex: 1;
    padding: 0.3rem 0.5rem;
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.7rem;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  .mode-btn:hover {
    color: var(--text);
    border-color: rgba(var(--accent-rgb), 0.6);
  }

  .mode-btn.active {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  :global(.color-grid) {
    display: grid;
    grid-template-columns: repeat(5, 24px);
    gap: 0.35rem;
    justify-content: start;
  }

  :global(.color-swatch) {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
    padding: 0;
    background: none;
    appearance: none;
  }

  :global(.color-swatch:hover) {
    transform: scale(1.2);
  }

  :global(.color-swatch.active) {
    border-color: var(--text);
    box-shadow: 0 0 8px rgba(var(--accent-rgb), 0.5);
  }

  /* Hide number input spinners */
  #sprite-dex-input::-webkit-inner-spin-button,
  #sprite-dex-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  #sprite-dex-input[type=number] {
    -moz-appearance: textfield;
  }

  @keyframes bubble-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 600px) {
    header {
      padding: 0.5rem 0.75rem;
      flex-wrap: nowrap;
      gap: 0.4rem;
    }

    .left-group {
      gap: 0.4rem;
    }

    #avatar-sprite {
      height: 26px;
    }

    .status-bubble {
      min-width: 160px;
      max-width: 200px;
    }

    .name-btn {
      font-size: 0.7rem;
      padding: 0.25rem 0.4rem;
    }

    .about-link {
      font-size: 0.55rem;
    }

    .github-link {
      font-size: 0.6rem;
      padding: 0.2rem 0.4rem;
    }

    .nav-link {
      font-size: 0.55rem;
    }

    .right-group {
      gap: 0.4rem;
    }

    .nav-links {
      gap: 0.4rem;
    }

    .settings-dropdown {
      min-width: 180px;
    }

    .color-swatch {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script>
  import { spriteUrl, loadImage, fetchAnimData } from '../utils/sprite-utils';

  const ELECTIVIRE_ID = 466;

  function initAvatar() {
    const canvas = document.getElementById('avatar-sprite') as HTMLCanvasElement | null;
    const bubble = document.getElementById('status-bubble');
    if (!canvas || !bubble) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const avatarBtn = document.getElementById('avatar-btn');
    if (avatarBtn) {
      avatarBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        bubble.classList.toggle('hidden');
      });
    }
    document.addEventListener('click', () => bubble.classList.add('hidden'));

    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = async () => {
      const animDims = await fetchAnimData(ELECTIVIRE_ID);
      let fw = animDims['Idle']?.w || 0;
      let fh = animDims['Idle']?.h || 0;
      if (!fw || !fh) { fh = Math.floor(img.naturalHeight / 8); fw = fh; }

      const frameCount = Math.max(1, Math.floor(img.naturalWidth / fw));
      let frame = 0;
      const cropH = Math.floor(fh * 0.70);
      canvas.width = fw;
      canvas.height = cropH;

      function draw() {
        ctx!.clearRect(0, 0, fw, cropH);
        ctx!.drawImage(img, frame * fw, 0, fw, cropH, 0, 0, fw, cropH);
      }

      draw();
      setInterval(() => { frame = (frame + 1) % frameCount; draw(); }, 150);
      setupFavicon(img, fw, fh, frameCount);
    };
    img.src = spriteUrl(ELECTIVIRE_ID, 'Idle');
  }

  function setupFavicon(img: HTMLImageElement, fw: number, fh: number, frameCount: number) {
    const size = 32;
    const srcH = Math.floor(fh * 0.60);
    // Crop-to-fill: scale up to cover the square, then center-crop
    const scale = Math.max(size / fw, size / srcH);
    const sw = Math.round(size / scale); // source width to sample
    const sh = Math.round(size / scale); // source height to sample
    const sox = Math.round((fw - sw) / 2) - 1; // nudge left
    const soy = Math.round((srcH - sh) / 2); // center vertically

    const favCanvas = document.createElement('canvas');
    favCanvas.width = size;
    favCanvas.height = size;
    const fCtx = favCanvas.getContext('2d');
    if (!fCtx) return;
    fCtx.imageSmoothingEnabled = false;

    let link = document.querySelector('link[rel="icon"]') as HTMLLinkElement | null;
    if (!link) {
      link = document.createElement('link');
      link.rel = 'icon';
      document.head.appendChild(link);
    }
    link.type = 'image/png';

    let frame = 0;
    const row = 0;

    function drawFav() {
      fCtx!.clearRect(0, 0, size, size);
      fCtx!.drawImage(img, frame * fw + sox, row * fh + soy, sw, sh, 0, 0, size, size);
      link!.href = favCanvas.toDataURL('image/png');
      frame = (frame + 1) % frameCount;
    }

    drawFav();
    setInterval(drawFav, 150);
  }

  // Run on initial load and after view transitions
  initAvatar();
  document.addEventListener('astro:after-swap', initAvatar);
</script>

<script is:inline>
  (function() {
    function toggle(el) {
      el.style.display = el.style.display === 'none' ? 'flex' : 'none';
    }

    function setup() {
      var settingsBtn = document.getElementById('settings-btn');
      var dropdown = document.getElementById('settings-dropdown');
      var pokemonTitle = document.getElementById('pokemon-title');
      var pokemonContent = document.getElementById('pokemon-content');
      var themeTitle = document.getElementById('theme-title');
      var themeContent = document.getElementById('theme-content');

      if (!settingsBtn || !dropdown) return;

      settingsBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        toggle(dropdown);
      });

      if (pokemonTitle && pokemonContent) {
        pokemonTitle.addEventListener('click', function(e) {
          e.stopPropagation();
          toggle(pokemonContent);
        });
      }

      if (themeTitle && themeContent) {
        themeTitle.addEventListener('click', function(e) {
          e.stopPropagation();
          toggle(themeContent);
        });
      }

      dropdown.addEventListener('click', function(e) { e.stopPropagation(); });
    }

    document.addEventListener('click', function() {
      var dd = document.getElementById('settings-dropdown');
      if (dd) dd.style.display = 'none';
    });

    // Run now and on every Astro page swap
    setup();
    document.addEventListener('astro:after-swap', setup);
  })();
</script>
