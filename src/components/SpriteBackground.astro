---
// SpriteBackground.astro
// Animated PMD sprite sheet characters walking around the page background.
// Canvas-based rendering with a state machine per sprite.
// Sprites persist across pages/refreshes via localStorage.
---

<div id="sprite-background" aria-hidden="true" transition:persist></div>



<style is:global>
  #sprite-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  #sprite-background canvas {
    position: absolute;
    image-rendering: pixelated;
    pointer-events: none;
  }

  .spawn-flash {
    position: fixed;
    width: 20px;
    height: 20px;
    margin-left: -10px;
    margin-top: -10px;
    border-radius: 50%;
    border: 0.3px solid #ffffff;
    background: transparent;
    pointer-events: none;
    z-index: 9999;
    animation: spawn-pulse 0.3s ease-out forwards;
  }

  @keyframes spawn-pulse {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(5); opacity: 0; }
  }

  #spawn-error {
    font-size: 0.7rem;
    color: #ff6b6b;
    margin-top: 0.25rem;
    animation: fade-out 3s ease-out forwards;
  }

  @keyframes fade-out {
    0%, 70% { opacity: 1; }
    100% { opacity: 0; }
  }
</style>

<script>
  // ── Config ──────────────────────────────────────────────
  const SCALE = 1;
  const FRAME_MS = 150;
  const ATTACK_FRAME_MS = 40;
  const MOVE_SPEED = 35;
  const SPRITE_COUNT = 10;
  const IDLE_CHANCE = 0.002;
  const IDLE_MS_MIN = 2000;
  const IDLE_MS_MAX = 4000;
  const SLEEP_TIMEOUT = 150000;    // 2.5 min of no interaction
  const ATTACK_MS = 1000;
  const HIT_RADIUS = 40;          // Click detection radius around sprite center
  const VISIBILITY_KEY = 'pmd-sprites-visible';
  const MAX_DEX_NUMBER = 1025;     // Total sprite folders (approx)

  // Curated Pokémon IDs known to have good sprites
  const POKEMON_IDS = [
    1, 4, 7, 25, 37, 39, 52, 54, 58, 94, 131, 133, 143, 150, 151,
    152, 155, 158, 175, 196, 197, 252, 255, 258, 300, 387, 390,
    393, 448, 570, 572, 403, 447, 334, 302, 352, 442, 479,
  ];

  const ACTIONS = ['Walk', 'Idle', 'Sleep', 'Attack'] as const;
  type Action = (typeof ACTIONS)[number];
  type SpriteState = 'walking' | 'idle' | 'sleeping' | 'attacking';

  // Direction rows: 0=S, 1=SE, 2=E, 3=NE, 4=N, 5=NW, 6=W, 7=SW
  const ANGLE_TO_ROW = [2, 1, 0, 7, 6, 5, 4, 3];

  interface FrameInfo { w: number; h: number; count: number }

  interface SpriteEntity {
    pokemonId: number;
    spawnOrder: number;
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    x: number; y: number;
    vx: number; vy: number;
    state: SpriteState;
    stateEnd: number;
    frame: number;
    lastFrame: number;
    direction: number;
    sheets: Record<Action, HTMLImageElement | null>;
    frameInfo: Record<Action, FrameInfo | null>;
  }

  // ── Helpers ─────────────────────────────────────────────
  function spriteUrl(id: number, action: string): string {
    return `https://raw.githubusercontent.com/PMDCollab/SpriteCollab/master/sprite/${String(id).padStart(4, '0')}/${action}-Anim.png`;
  }

  function animDataUrl(id: number): string {
    return `https://raw.githubusercontent.com/PMDCollab/SpriteCollab/master/sprite/${String(id).padStart(4, '0')}/AnimData.xml`;
  }

  function loadImage(url: string): Promise<HTMLImageElement | null> {
    return new Promise((resolve) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => resolve(img);
      img.onerror = () => resolve(null);
      img.src = url;
    });
  }

  async function fetchAnimData(id: number): Promise<Record<string, { w: number; h: number }>> {
    try {
      const res = await fetch(animDataUrl(id));
      const text = await res.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(text, 'text/xml');
      const anims = doc.querySelectorAll('Anim');
      const result: Record<string, { w: number; h: number }> = {};
      anims.forEach((anim) => {
        const name = anim.querySelector('Name')?.textContent ?? '';
        const w = parseInt(anim.querySelector('FrameWidth')?.textContent ?? '0', 10);
        const h = parseInt(anim.querySelector('FrameHeight')?.textContent ?? '0', 10);
        if (name && w > 0 && h > 0) result[name] = { w, h };
      });
      return result;
    } catch {
      return {};
    }
  }

  function calcFrameInfo(img: HTMLImageElement, dims: { w: number; h: number } | undefined): FrameInfo {
    if (dims && dims.w > 0 && dims.h > 0) {
      const count = Math.max(1, Math.floor(img.naturalWidth / dims.w));
      return { w: dims.w, h: dims.h, count };
    }
    const h = Math.floor(img.naturalHeight / 8);
    const w = h;
    const count = Math.max(1, Math.floor(img.naturalWidth / w));
    return { w, h, count };
  }

  function velocityToRow(vx: number, vy: number): number {
    const deg = ((Math.atan2(vy, vx) * 180) / Math.PI + 360) % 360;
    return ANGLE_TO_ROW[Math.round(deg / 45) % 8];
  }

  function randomVelocity(x: number, y: number): { vx: number; vy: number } {
    const W = window.innerWidth;
    const H = window.innerHeight;
    let vx = (Math.random() - 0.5) * 2;
    let vy = (Math.random() - 0.5) * 2;
    if (x < 100) vx = Math.abs(vx);
    else if (x > W - 100) vx = -Math.abs(vx);
    if (y < 100) vy = Math.abs(vy);
    else if (y > H - 100) vy = -Math.abs(vy);
    const mag = Math.sqrt(vx * vx + vy * vy) || 1;
    return { vx: (vx / mag) * MOVE_SPEED, vy: (vy / mag) * MOVE_SPEED };
  }

  function randRange(a: number, b: number): number {
    return a + Math.random() * (b - a);
  }

  function getHeaderBottom(): number {
    return document.querySelector('header')?.getBoundingClientRect().bottom ?? 60;
  }

  // ── Globals ─────────────────────────────────────────────
  const sprites: SpriteEntity[] = [];
  let spawnCounter = 0;
  let lastInteraction = performance.now();
  let allAsleep = false;

  function onUserActivity() {
    lastInteraction = performance.now();
  }
  document.addEventListener('mousemove', onUserActivity);
  document.addEventListener('keydown', onUserActivity);
  document.addEventListener('scroll', onUserActivity);

  // ── Sprite Creation ─────────────────────────────────────
  async function createSprite(
    container: HTMLElement,
    pokemonId: number,
    startX?: number,
    startY?: number,
    order?: number,
  ): Promise<SpriteEntity | null> {
    const [animDims, ...results] = await Promise.all([
      fetchAnimData(pokemonId),
      ...ACTIONS.map((a) => loadImage(spriteUrl(pokemonId, a))),
    ]);

    const sheets: Record<Action, HTMLImageElement | null> = {
      Walk: results[0], Idle: results[1], Sleep: results[2], Attack: results[3],
    };
    if (!sheets.Walk) return null;

    const frameInfo: Record<Action, FrameInfo | null> = {
      Walk: calcFrameInfo(sheets.Walk, animDims['Walk']),
      Idle: sheets.Idle ? calcFrameInfo(sheets.Idle, animDims['Idle']) : null,
      Sleep: sheets.Sleep ? calcFrameInfo(sheets.Sleep, animDims['Sleep']) : null,
      Attack: sheets.Attack ? calcFrameInfo(sheets.Attack, animDims['Attack']) : null,
    };

    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d')!;
    container.appendChild(canvas);

    const headerH = getHeaderBottom();
    const x = startX ?? Math.random() * (window.innerWidth - 100) + 50;
    const y = startY ?? Math.random() * (window.innerHeight - headerH - 80) + headerH;
    const { vx, vy } = randomVelocity(x, y);

    const assignedOrder = order ?? spawnCounter++;

    const sprite: SpriteEntity = {
      pokemonId,
      spawnOrder: assignedOrder,
      canvas, ctx, x, y, vx, vy,
      state: 'walking',
      stateEnd: 0,
      frame: 0,
      lastFrame: 0,
      direction: velocityToRow(vx, vy),
      sheets, frameInfo,
    };

    resizeCanvas(sprite, 'Walk');
    canvas.style.left = `${x}px`;
    canvas.style.top = `${y}px`;

    return sprite;
  }

  function resizeCanvas(s: SpriteEntity, action: Action) {
    const info = s.frameInfo[action] ?? s.frameInfo.Walk!;
    s.canvas.width = info.w * SCALE;
    s.canvas.height = info.h * SCALE;
  }

  // ── State Transitions ──────────────────────────────────
  function setWalking(s: SpriteEntity) {
    s.state = 'walking';
    s.frame = 0;
    const { vx, vy } = randomVelocity(s.x, s.y);
    s.vx = vx; s.vy = vy;
    s.direction = velocityToRow(vx, vy);
    resizeCanvas(s, 'Walk');
  }

  function setIdle(s: SpriteEntity) {
    s.state = 'idle';
    s.frame = 0;
    s.vx = 0; s.vy = 0;
    s.stateEnd = performance.now() + randRange(IDLE_MS_MIN, IDLE_MS_MAX);
    resizeCanvas(s, s.sheets.Idle ? 'Idle' : 'Walk');
  }

  function setSleeping(s: SpriteEntity) {
    s.state = 'sleeping';
    s.frame = 0;
    s.vx = 0; s.vy = 0;
    s.direction = 0;
    resizeCanvas(s, s.sheets.Sleep ? 'Sleep' : 'Walk');
  }

  function setAttacking(s: SpriteEntity) {
    s.state = 'attacking';
    s.frame = 0;
    s.vx = 0; s.vy = 0;
    s.direction = 0;
    resizeCanvas(s, s.sheets.Attack ? 'Attack' : 'Walk');
  }

  function handleSpriteClick(s: SpriteEntity) {
    lastInteraction = performance.now();
    allAsleep = false;
    if (s.state === 'sleeping') {
      setWalking(s);
    } else if (s.state !== 'attacking') {
      setAttacking(s);
    }
  }

  // ── Resolve Current Sheet ──────────────────────────────
  function getSheet(s: SpriteEntity): { img: HTMLImageElement; info: FrameInfo } {
    let action: Action = 'Walk';
    if (s.state === 'idle' && s.sheets.Idle) action = 'Idle';
    if (s.state === 'sleeping' && s.sheets.Sleep) action = 'Sleep';
    if (s.state === 'attacking' && s.sheets.Attack) action = 'Attack';
    return {
      img: s.sheets[action] ?? s.sheets.Walk!,
      info: s.frameInfo[action] ?? s.frameInfo.Walk!,
    };
  }

  // ── Swap Logic ─────────────────────────────────────────
  async function swapOldestSprite(requestedId?: number) {
    const container = document.getElementById('sprite-background');
    if (!container || sprites.length === 0) return;

    // Find oldest by spawnOrder
    let oldestIdx = 0;
    for (let i = 1; i < sprites.length; i++) {
      if (sprites[i].spawnOrder < sprites[oldestIdx].spawnOrder) oldestIdx = i;
    }

    // Pick new ID
    let newId: number;
    let newSprite: SpriteEntity | null = null;

    // Get old sprite's position before removing
    const old = sprites[oldestIdx];
    const oldX = old.x;
    const oldY = old.y;

    if (requestedId && requestedId >= 1 && requestedId <= MAX_DEX_NUMBER) {
      newId = requestedId;
      newSprite = await createSprite(container, newId, oldX, oldY);
      if (!newSprite) {
        showSpawnError(`No sprite available for #${newId}`);
        return;
      }
    } else {
      // Random — keep trying until we find one that works
      const usedIds = new Set(sprites.map((s) => s.pokemonId));
      const candidates = Array.from({ length: MAX_DEX_NUMBER }, (_, i) => i + 1)
        .filter((id) => !usedIds.has(id))
        .sort(() => Math.random() - 0.5);

      for (const id of candidates) {
        newSprite = await createSprite(container, id, oldX, oldY);
        if (newSprite) { newId = id; break; }
      }
      if (!newSprite) return;
    }

    // Success — remove old sprite and add new one
    old.canvas.remove();
    sprites.splice(oldestIdx, 1);
    newSprite.spawnOrder = spawnCounter++;
    sprites.push(newSprite);
    const walkInfo = newSprite.frameInfo.Walk!;
    showSpawnFlash(container, oldX + (walkInfo.w * SCALE) / 2, oldY + (walkInfo.h * SCALE) / 2);
  }

  // ── Spawn Error Message ────────────────────────────────
  function showSpawnError(msg: string) {
    const existing = document.getElementById('spawn-error');
    if (existing) existing.remove();
    const el = document.createElement('div');
    el.id = 'spawn-error';
    el.textContent = msg;
    const controls = document.getElementById('sprite-controls');
    if (controls) controls.appendChild(el);
    setTimeout(() => el.remove(), 3000);
  }

  // ── Spawn Flash ────────────────────────────────────────
  function showSpawnFlash(container: HTMLElement, x: number, y: number) {
    const flash = document.createElement('div');
    flash.className = 'spawn-flash';
    flash.style.left = `${x}px`;
    flash.style.top = `${y}px`;
    document.body.appendChild(flash);
    flash.addEventListener('animationend', () => flash.remove());
  }

  // ── Update & Render ────────────────────────────────────
  function update(now: number, dt: number) {
    if (now - lastInteraction > SLEEP_TIMEOUT && !allAsleep) {
      allAsleep = true;
      for (const s of sprites) {
        if (s.state === 'walking' || s.state === 'idle') setSleeping(s);
      }
    }

    for (const s of sprites) {
      switch (s.state) {
        case 'walking': {
          s.x += s.vx * (dt / 1000);
          s.y += s.vy * (dt / 1000);
          const W = window.innerWidth;
          const H = window.innerHeight;
          const headerH = getHeaderBottom();
          if (s.x < 20 || s.x > W - 80 || s.y < headerH || s.y > H - 80) {
            s.x = Math.max(20, Math.min(W - 80, s.x));
            s.y = Math.max(headerH, Math.min(H - 80, s.y));
            const v = randomVelocity(s.x, s.y);
            s.vx = v.vx; s.vy = v.vy;
            s.direction = velocityToRow(v.vx, v.vy);
          }
          if (!allAsleep && Math.random() < IDLE_CHANCE) setIdle(s);
          break;
        }
        case 'idle':
          if (now >= s.stateEnd) {
            allAsleep ? setSleeping(s) : setWalking(s);
          }
          break;
        case 'attacking':
          break;
        case 'sleeping':
          break;
      }

      const frameMs = s.state === 'attacking' ? ATTACK_FRAME_MS : FRAME_MS;
      if (now - s.lastFrame >= frameMs) {
        const { info } = getSheet(s);
        const nextFrame = s.frame + 1;
        if (s.state === 'attacking' && nextFrame >= info.count) {
          setWalking(s);
        } else {
          s.frame = nextFrame % info.count;
        }
        s.lastFrame = now;
      }

      const { img, info } = getSheet(s);
      s.ctx.clearRect(0, 0, s.canvas.width, s.canvas.height);
      s.ctx.drawImage(
        img,
        s.frame * info.w, s.direction * info.h, info.w, info.h,
        0, 0, info.w * SCALE, info.h * SCALE,
      );
      // Offset position so sprite stays centered when action frame size differs from Walk
      const walkInfo = s.frameInfo.Walk!;
      const offsetX = ((walkInfo.w - info.w) * SCALE) / 2;
      const offsetY = ((walkInfo.h - info.h) * SCALE) / 2;
      s.canvas.style.left = `${s.x + offsetX}px`;
      s.canvas.style.top = `${s.y + offsetY}px`;
    }
  }

  // ── Main Loop ──────────────────────────────────────────
  let lastTime = 0;
  function loop(now: number) {
    const dt = lastTime ? now - lastTime : 16;
    lastTime = now;
    update(now, Math.min(dt, 100));
    requestAnimationFrame(loop);
  }

  // ── Init ───────────────────────────────────────────────
  async function init() {
    const container = document.getElementById('sprite-background');
    if (!container) return;

    // Always spawn fresh random Pokémon on each load from full dex
    const allIds = Array.from({ length: MAX_DEX_NUMBER }, (_, i) => i + 1);
    const shuffled = allIds.sort(() => Math.random() - 0.5);

    let loaded = 0;
    for (const id of shuffled) {
      if (loaded >= SPRITE_COUNT) break;
      const sprite = await createSprite(container, id);
      if (sprite) {
        sprite.spawnOrder = spawnCounter++;
        sprites.push(sprite);
        loaded++;
      }
    }

    if (sprites.length > 0) requestAnimationFrame(loop);

    wireControls();

    // ── Click-to-attack via proximity detection ──────────
    document.addEventListener('click', (e) => {
      const cx = e.clientX;
      const cy = e.clientY;
      let closest: SpriteEntity | null = null;
      let closestDist = Infinity;
      for (const s of sprites) {
        const info = s.frameInfo.Walk!;
        const sx = s.x + (info.w * SCALE) / 2;
        const sy = s.y + (info.h * SCALE) / 2;
        const dist = Math.sqrt((cx - sx) ** 2 + (cy - sy) ** 2);
        if (dist < closestDist) {
          closestDist = dist;
          closest = s;
        }
      }
      if (closest && closestDist < HIT_RADIUS) {
        handleSpriteClick(closest);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // ── Wire up sprite controls (survives view transitions) ──
  let spawning = false;
  function wireControls() {
    const container = document.getElementById('sprite-background');
    const btn = document.getElementById('sprite-swap-btn') as HTMLButtonElement | null;
    const input = document.getElementById('sprite-dex-input') as HTMLInputElement | null;
    const toggleBtn = document.getElementById('sprite-toggle-btn');

    if (btn) {
      btn.onclick = async () => {
        if (spawning) return;
        spawning = true;
        btn.disabled = true;
        btn.style.opacity = '0.5';
        const val = input?.value ? parseInt(input.value, 10) : undefined;
        if (input) input.value = '';
        await swapOldestSprite(val);
        btn.disabled = false;
        btn.style.opacity = '';
        spawning = false;
      };
    }

    if (toggleBtn && container) {
      const isHidden = localStorage.getItem(VISIBILITY_KEY) === 'hidden';
      if (isHidden) {
        container.style.display = 'none';
        toggleBtn.textContent = 'Show';
      }
      toggleBtn.onclick = () => {
        const nowHidden = container.style.display === 'none';
        container.style.display = nowHidden ? '' : 'none';
        localStorage.setItem(VISIBILITY_KEY, nowHidden ? 'visible' : 'hidden');
        toggleBtn.textContent = nowHidden ? 'Hide' : 'Show';
      };
    }
  }

  wireControls();
  document.addEventListener('astro:after-swap', wireControls);
</script>
