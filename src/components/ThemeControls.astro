---
// ThemeControls.astro
// Collapsible theme picker: dark/light mode toggle + 20 accent color swatches.
// Positioned bottom-right, mirrors the style of Pokémon Controls.
// Persists via localStorage and survives page transitions.
---

<div id="theme-controls" transition:persist>
  <span id="theme-controls-title" role="button" tabindex="0">Theme</span>
  <div id="theme-controls-panel" class="hidden">
    <div class="theme-section">
      <span class="theme-label">Mode</span>
      <div class="mode-toggle">
        <button id="mode-dark" class="mode-btn active" title="Dark mode">Dark</button>
        <button id="mode-light" class="mode-btn" title="Light mode">Light</button>
      </div>
    </div>
    <div class="theme-section">
      <span class="theme-label">Accent</span>
      <div class="color-grid" id="color-grid"></div>
    </div>
  </div>
</div>

<style is:global>
  #theme-controls {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }

  #theme-controls-title {
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-align: center;
    cursor: pointer;
    user-select: none;
    transition: color 0.2s;
  }

  [data-theme="light"] #theme-controls-title {
    color: var(--text-muted);
  }

  #theme-controls-title:hover {
    color: var(--text);
  }

  [data-theme="light"] #theme-controls-title:hover {
    color: var(--text);
  }

  #theme-controls-panel.hidden {
    display: none;
  }

  #theme-controls-panel {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.75rem;
    background: var(--bg-card);
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 8px;
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    min-width: 180px;
  }

  .theme-section {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .theme-label {
    font-size: 0.6rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .mode-toggle {
    display: flex;
    gap: 0.3rem;
  }

  .mode-btn {
    flex: 1;
    padding: 0.3rem 0.5rem;
    border: 1px solid rgba(var(--accent-rgb), 0.4);
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    font-family: 'Fusion Pixel 12px Proportional KR', sans-serif;
    font-size: 0.7rem;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  .mode-btn:hover {
    color: var(--text);
    border-color: rgba(var(--accent-rgb), 0.6);
  }

  .mode-btn.active {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .color-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.35rem;
  }

  .color-swatch {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
    position: relative;
  }

  .color-swatch:hover {
    transform: scale(1.2);
  }

  .color-swatch.active {
    border-color: var(--text);
    box-shadow: 0 0 8px rgba(var(--accent-rgb), 0.5);
  }

  @media (max-width: 600px) {
    #theme-controls {
      bottom: 0.75rem;
      right: 0.75rem;
    }

    .color-swatch {
      width: 20px;
      height: 20px;
    }

    #theme-controls-panel {
      min-width: 150px;
    }
  }
</style>

<script>
  const ACCENT_COLORS = [
    { name: 'Gold',     rgb: '245,208,0' },
    { name: 'Red',      rgb: '239,68,68' },
    { name: 'Coral',    rgb: '251,113,133' },
    { name: 'Orange',   rgb: '249,115,22' },
    { name: 'Amber',    rgb: '245,158,11' },
    { name: 'Lime',     rgb: '132,204,22' },
    { name: 'Green',    rgb: '34,197,94' },
    { name: 'Emerald',  rgb: '16,185,129' },
    { name: 'Teal',     rgb: '20,184,166' },
    { name: 'Cyan',     rgb: '6,182,212' },
    { name: 'Sky',      rgb: '14,165,233' },
    { name: 'Blue',     rgb: '59,130,246' },
    { name: 'Indigo',   rgb: '99,102,241' },
    { name: 'Violet',   rgb: '139,92,246' },
    { name: 'Purple',   rgb: '168,85,247' },
    { name: 'Fuchsia',  rgb: '217,70,239' },
    { name: 'Pink',     rgb: '236,72,153' },
    { name: 'Rose',     rgb: '244,63,94' },
    { name: 'White',    rgb: '255,255,255' },
    { name: 'Silver',   rgb: '163,163,163' },
  ];

  function applyTheme(mode: string, accentRgb: string) {
    const r = document.documentElement;
    r.setAttribute('data-theme', mode);
    r.style.setProperty('--accent-rgb', accentRgb);
    r.style.setProperty('--accent', `rgb(${accentRgb})`);

    if (mode === 'light') {
      r.style.setProperty('--bg', '#f5f5f5');
      r.style.setProperty('--bg-rgb', '245,245,245');
      r.style.setProperty('--bg-card', 'rgba(255,255,255,0.9)');
      r.style.setProperty('--text', 'rgba(30,30,30,0.9)');
      r.style.setProperty('--text-muted', 'rgba(30,30,30,0.55)');
      r.style.setProperty('--text-faint', 'rgba(30,30,30,0.35)');
      r.style.setProperty('--header-bg', 'rgba(245,245,245,0.9)');
    } else {
      r.style.setProperty('--bg', '#1a1a1a');
      r.style.setProperty('--bg-rgb', '26,26,26');
      r.style.setProperty('--bg-card', 'rgba(26,26,26,0.9)');
      r.style.setProperty('--text', 'rgba(255,255,255,0.85)');
      r.style.setProperty('--text-muted', 'rgba(255,255,255,0.5)');
      r.style.setProperty('--text-faint', 'rgba(255,255,255,0.35)');
      r.style.setProperty('--header-bg', 'rgba(26,26,26,0.9)');
    }

    localStorage.setItem('theme-mode', mode);
    localStorage.setItem('theme-accent', accentRgb);
  }

  function initThemeControls() {
    const title = document.getElementById('theme-controls-title');
    const panel = document.getElementById('theme-controls-panel');
    const grid = document.getElementById('color-grid');
    const darkBtn = document.getElementById('mode-dark');
    const lightBtn = document.getElementById('mode-light');

    if (!title || !panel || !grid || !darkBtn || !lightBtn) return;

    // Toggle panel
    title.addEventListener('click', (e) => {
      e.stopPropagation();
      panel.classList.toggle('hidden');
    });

    // Close on click outside
    panel.addEventListener('click', (e) => e.stopPropagation());
    document.addEventListener('click', () => panel.classList.add('hidden'));

    // Read saved state
    const savedMode = localStorage.getItem('theme-mode') || 'dark';
    const savedAccent = localStorage.getItem('theme-accent') || '245,208,0';

    // Mode buttons
    if (savedMode === 'light') {
      darkBtn.classList.remove('active');
      lightBtn.classList.add('active');
    }

    darkBtn.addEventListener('click', () => {
      darkBtn.classList.add('active');
      lightBtn.classList.remove('active');
      applyTheme('dark', localStorage.getItem('theme-accent') || '245,208,0');
    });

    lightBtn.addEventListener('click', () => {
      lightBtn.classList.add('active');
      darkBtn.classList.remove('active');
      applyTheme('light', localStorage.getItem('theme-accent') || '245,208,0');
    });

    // Build color swatches
    grid.innerHTML = '';
    ACCENT_COLORS.forEach((color) => {
      const swatch = document.createElement('button');
      swatch.className = 'color-swatch';
      swatch.title = color.name;
      swatch.style.backgroundColor = `rgb(${color.rgb})`;
      swatch.dataset.rgb = color.rgb;

      if (color.rgb === savedAccent) swatch.classList.add('active');

      swatch.addEventListener('click', () => {
        grid.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
        swatch.classList.add('active');
        applyTheme(
          localStorage.getItem('theme-mode') || 'dark',
          color.rgb
        );
      });

      grid.appendChild(swatch);
    });
  }

  initThemeControls();
  document.addEventListener('astro:after-swap', initThemeControls);
</script>
