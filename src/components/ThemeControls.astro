---
// ThemeControls.astro
// Theme JS only — UI lives in Header.astro settings dropdown.
---

<script>
  import { applyTheme } from '../utils/theme-utils';

  // Lighter shades for dark backgrounds
  const DARK_MODE_COLORS = [
    { name: 'Gold',     rgb: '245,208,0' },
    { name: 'Red',      rgb: '239,68,68' },
    { name: 'Coral',    rgb: '251,113,133' },
    { name: 'Orange',   rgb: '249,115,22' },
    { name: 'Amber',    rgb: '245,158,11' },
    { name: 'Lime',     rgb: '132,204,22' },
    { name: 'Green',    rgb: '34,197,94' },
    { name: 'Emerald',  rgb: '16,185,129' },
    { name: 'Teal',     rgb: '20,184,166' },
    { name: 'Cyan',     rgb: '6,182,212' },
    { name: 'Sky',      rgb: '56,189,248' },
    { name: 'Blue',     rgb: '96,165,250' },
    { name: 'Indigo',   rgb: '129,140,248' },
    { name: 'Violet',   rgb: '167,139,250' },
    { name: 'Purple',   rgb: '192,132,252' },
    { name: 'Fuchsia',  rgb: '232,121,249' },
    { name: 'Pink',     rgb: '244,114,182' },
    { name: 'Rose',     rgb: '251,113,133' },
    { name: 'White',    rgb: '255,255,255' },
    { name: 'Silver',   rgb: '163,163,163' },
  ];

  // Darker shades for light backgrounds
  const LIGHT_MODE_COLORS = [
    { name: 'Gold',     rgb: '161,98,7' },
    { name: 'Red',      rgb: '185,28,28' },
    { name: 'Coral',    rgb: '190,18,60' },
    { name: 'Orange',   rgb: '194,65,12' },
    { name: 'Amber',    rgb: '180,83,9' },
    { name: 'Lime',     rgb: '63,98,18' },
    { name: 'Green',    rgb: '21,128,61' },
    { name: 'Emerald',  rgb: '4,120,87' },
    { name: 'Teal',     rgb: '15,118,110' },
    { name: 'Cyan',     rgb: '14,116,144' },
    { name: 'Sky',      rgb: '3,105,161' },
    { name: 'Blue',     rgb: '29,78,216' },
    { name: 'Indigo',   rgb: '67,56,202' },
    { name: 'Violet',   rgb: '109,40,217' },
    { name: 'Purple',   rgb: '126,34,206' },
    { name: 'Fuchsia',  rgb: '162,28,175' },
    { name: 'Pink',     rgb: '190,24,93' },
    { name: 'Rose',     rgb: '190,18,60' },
    { name: 'Slate',    rgb: '51,65,85' },
    { name: 'Charcoal', rgb: '30,30,30' },
  ];

  function getColorsForMode(mode: string) {
    return mode === 'light' ? LIGHT_MODE_COLORS : DARK_MODE_COLORS;
  }

  function buildSwatches(grid: HTMLElement, mode: string, currentAccent: string) {
    const colors = getColorsForMode(mode);
    grid.innerHTML = '';
    colors.forEach((color) => {
      const swatch = document.createElement('button');
      swatch.className = 'color-swatch';
      swatch.title = color.name;
      swatch.style.backgroundColor = `rgb(${color.rgb})`;
      swatch.dataset.rgb = color.rgb;

      if (color.rgb === currentAccent) swatch.classList.add('active');

      swatch.addEventListener('click', () => {
        grid.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('active'));
        swatch.classList.add('active');
        applyTheme(
          localStorage.getItem('theme-mode') || 'light',
          color.rgb
        );
      });

      grid.appendChild(swatch);
    });
  }

  function initThemeControls() {
    const grid = document.getElementById('color-grid');
    const darkBtn = document.getElementById('mode-dark');
    const lightBtn = document.getElementById('mode-light');

    if (!grid || !darkBtn || !lightBtn) return;

    // Read saved state
    const savedMode = localStorage.getItem('theme-mode') || 'dark';
    const savedAccent = localStorage.getItem('theme-accent') || '255,255,255';

    // Mode buttons
    if (savedMode === 'light') {
      darkBtn.classList.remove('active');
      lightBtn.classList.add('active');
    }

    darkBtn.addEventListener('click', () => {
      darkBtn.classList.add('active');
      lightBtn.classList.remove('active');
      applyTheme('dark', '255,255,255');
      buildSwatches(grid, 'dark', '255,255,255');
    });

    lightBtn.addEventListener('click', () => {
      lightBtn.classList.add('active');
      darkBtn.classList.remove('active');
      applyTheme('light', '30,30,30');
      buildSwatches(grid, 'light', '30,30,30');
    });

    // Build color swatches for current mode
    buildSwatches(grid, savedMode, savedAccent);
  }

  initThemeControls();
  document.addEventListener('astro:after-swap', initThemeControls);
</script>
